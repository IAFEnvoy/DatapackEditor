        "$registry": "mxt:forging_method",
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      }
    }
  },
  "id": "mxt-tool_binding",
