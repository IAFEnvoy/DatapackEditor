{
  "$title": {
    "en_us": "MiXianTu Resource",
    "zh_cn": "实体数值资源"
  },
  "$description": {
    "en_us": "Data-driven Resource definition from MiXianTu.",
    "zh_cn": "定义实体持有的可消耗数值，例如灵力、真元或神识；上限与恢复量可按境界和已吸收灵气动态计算。"
  },
  "type": "object",
  "required": [
    "default_value",
    "max"
  ],
  "properties": {
    "name": {
      "$title": {
        "en_us": "Name",
        "zh_cn": "名称"
      },
      "$description": {
        "en_us": "Name of this Resource.",
        "zh_cn": "名称的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "description": {
      "$title": {
        "en_us": "Description",
        "zh_cn": "描述"
      },
      "$description": {
        "en_us": "Description of this Resource.",
        "zh_cn": "描述的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "default_value": {
      "$title": {
        "en_us": "Default Value",
        "zh_cn": "初始值"
      },
      "$description": {
        "en_us": "Default Value of this Resource.",
        "zh_cn": "实体首次获得此数值资源时写入的当前值；最终值会被最小值与最大值限制。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "min": {
      "$title": {
        "en_us": "Min",
        "zh_cn": "最小值"
      },
      "$description": {
        "en_us": "Min of this Resource.",
        "zh_cn": "该数值资源允许的最低当前值。省略时为 0；支持数值或公式。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "max": {
      "$title": {
        "en_us": "Max",
        "zh_cn": "最大值"
      },
      "$description": {
        "en_us": "Max of this Resource.",
        "zh_cn": "该数值资源的当前上限，支持数值或公式。公式可使用 realm、realm_rank、level、absorbed_aura 与 cultivation_progress。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "icon": {
      "$title": {
        "en_us": "Icon",
        "zh_cn": "图标"
      },
      "$description": {
        "en_us": "Icon of this Resource.",
        "zh_cn": "图标的值。"
      },
      "$type": "mxt-common#record_IconReference"
    },
    "particle_color": {
      "$title": {
        "en_us": "Particle Color",
        "zh_cn": "粒子颜色"
      },
      "$description": {
        "en_us": "Particle Color of this Resource.",
        "zh_cn": "粒子颜色的值。"
      },
      "type": [
        "integer",
        "string"
      ],
      "default": 1048575
    },
    "bars": {
      "$title": {
        "en_us": "Bars",
        "zh_cn": "资源条"
      },
      "$description": {
        "en_us": "Bars of this Resource.",
        "zh_cn": "此资源的内联 HUD 显示条；资源归属由父级定义自动确定。"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-ability#record_ResourceBar",
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      }
    }
  },
  "id": "mxt-resource",
  "$version": "26.1.2",
  "$registry": "mxt:resource",
  "$path": "data/<namespace>/mxt/resource/<path>.json"
}
