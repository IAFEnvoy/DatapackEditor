{
  "$title": {
    "en_us": "MiXianTu Aura Zone",
    "zh_cn": "觅仙途灵气区域"
  },
  "$description": {
    "en_us": "Data-driven Aura Zone definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的灵气环境区域定义。"
  },
  "type": "object",
  "properties": {
    "base_aura": {
      "$title": {
        "en_us": "Base Aura",
        "zh_cn": "基础灵气"
      },
      "type": "number",
      "default": 0,
      "$description": {
        "en_us": "Base Aura value.",
        "zh_cn": "基础灵气的值。"
      }
    },
    "regen_per_tick": {
      "$title": {
        "en_us": "Regen Per Tick",
        "zh_cn": "每刻恢复"
      },
      "type": "number",
      "default": 0,
      "$description": {
        "en_us": "Regen Per Tick value.",
        "zh_cn": "每刻恢复的值。"
      }
    },
    "element_aura": {
      "$title": {
        "en_us": "Element Aura",
        "zh_cn": "元素灵气"
      },
      "type": "string",
      "$registry": "mxt:element",
      "$description": {
        "en_us": "Element Aura value.",
        "zh_cn": "元素灵气的值。"
      }
    },
    "aura_kinds": {
      "$title": {
        "en_us": "Aura Kinds",
        "zh_cn": "灵气类型"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Aura kinds required or provided by this aura zone.",
        "zh_cn": "该灵气区域提供的灵气类型，用于类型判断。"
      }
    },
    "dimensions": {
      "$title": {
        "en_us": "Dimensions",
        "zh_cn": "维度"
      },
      "$description": {
        "en_us": "Dimensions value.",
        "zh_cn": "维度的值。"
      }
    },
    "biomes": {
      "$title": {
        "en_us": "Biomes",
        "zh_cn": "生物群系"
      },
      "type": "array",
      "items": {
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Biomes value.",
        "zh_cn": "生物群系的值。"
      }
    },
    "fluctuation": {
      "$title": {
        "en_us": "Fluctuation",
        "zh_cn": "波动"
      },
      "$type": "mxt-common#record_Fluctuation",
      "$description": {
        "en_us": "Fluctuation value.",
        "zh_cn": "波动的值。"
      }
    },
    "rules": {
      "$title": {
        "en_us": "Rules",
        "zh_cn": "规则"
      },
      "$type": "mxt-common#record_Rules",
      "$description": {
        "en_us": "Rules value.",
        "zh_cn": "规则的值。"
      }
    },
    "element_fit_bonus": {
      "$title": {
        "en_us": "Element Fit Bonus",
        "zh_cn": "元素契合加成"
      },
      "type": "number",
      "default": 0,
      "$description": {
        "en_us": "Element Fit Bonus value.",
        "zh_cn": "元素契合加成的值。"
      }
    },
    "element_conflict_penalty": {
      "$title": {
        "en_us": "Element Conflict Penalty",
        "zh_cn": "元素冲突惩罚"
      },
      "type": "number",
      "default": 0,
      "$description": {
        "en_us": "Element Conflict Penalty value.",
        "zh_cn": "元素冲突惩罚的值。"
      }
    },
    "noise": {
      "$title": {
        "en_us": "Noise",
        "zh_cn": "噪声"
      },
      "$type": "mxt-common#record_Noise",
      "$description": {
        "en_us": "Noise value.",
        "zh_cn": "噪声的值。"
      }
    },
    "client_render": {
      "$title": {
        "en_us": "Client Render",
        "zh_cn": "客户端渲染"
      },
      "$type": "mxt-common#record_ClientRender",
      "$description": {
        "en_us": "Client Render value.",
        "zh_cn": "客户端渲染的值。"
      }
    },
    "client_hud": {
      "$title": {
        "en_us": "Client Hud",
        "zh_cn": "客户端 HUD"
      },
      "$type": "mxt-common#record_ClientHud",
      "$description": {
        "en_us": "Client Hud value.",
        "zh_cn": "客户端 HUD的值。"
      }
    }
  },
  "id": "mxt-aura_zone",
  "$version": "26.1.2",
  "$registry": "mxt:aura_zone",
  "$path": "data/<namespace>/mxt/aura_zone/<path>.json"
}
