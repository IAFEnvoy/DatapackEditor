            "ability": {
              "$title": {
                "en_us": "Ability",
                "zh_cn": "技能"
              },
              "type": "string",
              "$registry": "mxt:ability",
              "$description": {
                "en_us": "Ability value.",
                "zh_cn": "技能的值。"
              }
            }
          },
          "required": [
            "ability"
          ]
