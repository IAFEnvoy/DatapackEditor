          "$suggstion": true,
          "default": "mxt:always_true",
          "$description": {
            "en_us": "Type value.",
            "zh_cn": "类型的值。"
          }
        }
      },
      "$variants": {
        "mxt:always_true": {
          "$title": {
            "en_us": "Always True",
            "zh_cn": "始终为真"
