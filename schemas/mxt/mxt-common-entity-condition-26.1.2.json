          "$description": {
            "en_us": "Never passes.",
            "zh_cn": "永远不通过。"
          },
          "type": "object",
          "properties": {}
        },
        "mxt:and": {
          "$title": {
            "en_us": "And",
            "zh_cn": "全部满足"
          },
          "$description": {
            "en_us": "Passes when every child condition passes.",
            "zh_cn": "所有子条件都满足时通过。"
          },
          "type": "object",
          "properties": {
            "conditions": {
              "$title": {
                "en_us": "Conditions",
                "zh_cn": "条件"
              },
              "type": "array",
              "items": {
                "$type": "mxt-common-entity-condition#entity_condition",
                "$title": {
                  "en_us": "Condition",
                  "zh_cn": "条件"
                },
                "$description": {
                  "en_us": "One child condition.",
                  "zh_cn": "一个子条件。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Conditions value.",
                "zh_cn": "条件的值。"
              }
            }
          },
          "required": [
            "conditions"
          ]
        },
        "mxt:not": {
          "$title": {
            "en_us": "Not",
            "zh_cn": "条件取反"
          },
          "$description": {
            "en_us": "Passes when the child condition fails.",
            "zh_cn": "子条件不满足时通过。"
          },
          "type": "object",
          "properties": {
            "condition": {
              "$title": {
                "en_us": "Condition",
                "zh_cn": "条件"
              },
              "$description": {
                "en_us": "Condition value.",
                "zh_cn": "条件的值。"
              }
            }
          },
          "required": [
            "condition"
          ]
        },
        "mxt:or": {
          "$title": {
            "en_us": "Or",
            "zh_cn": "任一满足"
          },
          "$description": {
            "en_us": "Passes when any child condition passes.",
            "zh_cn": "任一子条件满足时通过。"
          },
          "type": "object",
          "properties": {
            "conditions": {
              "$title": {
                "en_us": "Conditions",
                "zh_cn": "条件"
              },
              "type": "array",
              "items": {
                "$type": "mxt-common-entity-condition#entity_condition",
                "$title": {
                  "en_us": "Condition",
                  "zh_cn": "条件"
                },
                "$description": {
                  "en_us": "One child condition.",
                  "zh_cn": "一个子条件。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Conditions value.",
                "zh_cn": "条件的值。"
              }
            }
          },
          "required": [
            "conditions"
          ]
        },
