    "entity_condition": {
      "$title": {
        "en_us": "Entity Condition",
        "zh_cn": "实体条件"
      },
      "$description": {
        "en_us": "Entity Condition selected by a type identifier.",
        "zh_cn": "实体条件的值。"
      },
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$title": {
            "en_us": "Type",
            "zh_cn": "类型"
          },
          "type": "string",
          "enum": [
            "mxt:always_true",
            "mxt:js",
            "mxt:never",
            "mxt:and",
            "mxt:not",
            "mxt:or",
            "mxt:sneaking",
            "mxt:has_ability",
            "mxt:has_curse",
            "mxt:realm",
            "mxt:aura_range",
            "mxt:resource_compare",
            "mxt:entity_tag",
            "mxt:formation_member",
            "mxt:air",
            "mxt:dimension",
            "mxt:entity_type",
            "mxt:fall_distance",
            "mxt:glowing",
            "mxt:health",
            "mxt:exposed_to_sky",
            "mxt:food_level",
            "mxt:mob_effect",
            "mxt:on_block",
            "mxt:time_of_day",
            "mxt:using_item",
            "mxt:brightness",
            "mxt:exposed_to_sun",
