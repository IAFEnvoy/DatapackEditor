            "mxt:chance",
            "mxt:constant",
            "mxt:attribute",
            "mxt:block_collision",
            "mxt:can_have_effect",
            "mxt:gamemode",
            "mxt:passenger",
            "mxt:attack_cooldown",
            "mxt:equipped_item",
            "mxt:in_block",
            "mxt:in_block_anywhere",
            "mxt:scoreboard",
            "mxt:riding",
            "mxt:riding_recursive",
            "mxt:passenger_recursive",
            "mxt:riding_root"
