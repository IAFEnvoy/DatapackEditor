{
  "$title": {
    "en_us": "MiXianTu Spirit Herb",
    "zh_cn": "觅仙途灵草"
  },
  "$description": {
    "en_us": "Data-driven Spirit Herb definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的灵草定义。"
  },
  "type": "object",
  "properties": {
    "items": {
      "$title": {
        "en_us": "Items",
        "zh_cn": "物品"
      },
      "$type": "mxt-common#item_matcher",
      "$description": {
        "en_us": "Items that are this herb.",
        "zh_cn": "属于该灵草的物品。"
      }
    },
    "quality": {
      "$title": {
        "en_us": "Quality",
        "zh_cn": "品质"
      },
      "type": "string",
      "$registry": "mxt:item_quality",
      "$description": {
        "en_us": "Quality of the harvested herb.",
        "zh_cn": "收获灵草的品质。"
      }
    },
    "age": {
      "$title": {
        "en_us": "Age",
        "zh_cn": "年龄"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Growth age this entry describes.",
        "zh_cn": "该条目描述的灵草生长年龄。"
      }
    },
    "element_tags": {
      "$title": {
        "en_us": "Element Tags",
        "zh_cn": "元素标签"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Tag",
          "zh_cn": "标签"
        },
        "$description": {
          "en_us": "One tag id.",
          "zh_cn": "一个标签 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Elements this herb carries.",
        "zh_cn": "该灵草携带的元素标签。"
      }
    },
    "material_tags": {
      "$title": {
        "en_us": "Material Tags",
        "zh_cn": "材料标签"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Tag",
          "zh_cn": "标签"
        },
        "$description": {
          "en_us": "One tag id.",
          "zh_cn": "一个标签 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Material tags this herb counts as.",
        "zh_cn": "该灵草被视为的材料标签。"
      }
    },
    "growth_rate": {
      "$title": {
        "en_us": "Growth Rate",
        "zh_cn": "生长速率"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "How fast the herb grows.",
        "zh_cn": "该灵草的生长速率。"
      }
    },
    "drop_chance": {
      "$title": {
        "en_us": "Drop Chance",
        "zh_cn": "掉落概率"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Chance of the herb dropping when harvested.",
        "zh_cn": "收获时掉落该灵草的概率。"
      }
    }
  },
  "required": [
    "items",
    "quality"
  ],
  "id": "mxt-spirit_herb",
  "$version": "26.1.2",
  "$registry": "mxt:spirit_herb",
  "$path": "data/<namespace>/mxt/spirit_herb/<path>.json"
}
