{
  "$title": {
    "en_us": "MiXianTu Curse",
    "zh_cn": "觅仙途诅咒"
  },
  "$description": {
    "en_us": "Data-driven Curse definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的诅咒定义。"
  },
  "type": "object",
  "properties": {
    "duration_ticks": {
      "$title": {
        "en_us": "Duration Ticks",
        "zh_cn": "持续刻数"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "How long the curse lasts, in ticks.",
        "zh_cn": "诅咒持续的时间，单位 tick。"
      }
    },
    "tick_interval": {
      "$title": {
        "en_us": "Tick Interval",
        "zh_cn": "周期刻数"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "How often the curse ticks, in ticks.",
        "zh_cn": "诅咒的触发间隔，单位 tick。"
      }
    },
    "max_stacks": {
      "$title": {
        "en_us": "Max Stacks",
        "zh_cn": "最大层数"
      },
      "type": "integer",
      "default": 1,
      "$description": {
        "en_us": "Highest stack count the curse may reach.",
        "zh_cn": "诅咒可以叠加到的最高层数。"
      }
    },
    "stacking_mode": {
      "$title": {
        "en_us": "Stacking Mode",
        "zh_cn": "叠加模式"
      },
      "$type": "mxt-common#record_StackingMode",
      "$description": {
        "en_us": "How further applications combine with the stacks already there.",
        "zh_cn": "再次施加时与已有层数的叠加方式。"
      }
    },
    "application_condition": {
      "$title": {
        "en_us": "Application Condition",
        "zh_cn": "施加条件"
      },
      "$type": "mxt-common-entity-condition#entity_condition",
      "$description": {
        "en_us": "Condition required before the curse may be applied.",
        "zh_cn": "施加该诅咒前需要满足的条件。"
      }
    },
    "on_apply": {
      "$title": {
        "en_us": "On Apply",
        "zh_cn": "施加时行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the curse is applied.",
        "zh_cn": "诅咒被施加时执行的行为。"
      }
    },
    "on_tick": {
      "$title": {
        "en_us": "On Tick",
        "zh_cn": "周期行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run on every curse tick.",
        "zh_cn": "诅咒每刻执行的行为。"
      }
    },
    "on_remove": {
      "$title": {
        "en_us": "On Remove",
        "zh_cn": "移除时行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the curse ends or is cleansed.",
        "zh_cn": "诅咒结束或被净化时执行的行为。"
      }
    },
    "cleanse_tags": {
      "$title": {
        "en_us": "Cleanse Tags",
        "zh_cn": "净化标签"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Tag",
          "zh_cn": "标签"
        },
        "$description": {
          "en_us": "One tag id.",
          "zh_cn": "一个标签 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Tags deciding which effects may cleanse this curse.",
        "zh_cn": "决定哪些效果可以净化该诅咒的标签。"
      }
    },
    "allow_force_remove": {
      "$title": {
        "en_us": "Allow Force Remove",
        "zh_cn": "允许强制移除"
      },
      "type": "boolean",
      "default": false,
      "$description": {
        "en_us": "Whether the curse may be removed by force.",
        "zh_cn": "是否允许被强制移除。"
      }
    }
  },
  "id": "mxt-curse",
  "$version": "26.1.2",
  "$registry": "mxt:curse",
  "$path": "data/<namespace>/mxt/curse/<path>.json"
}
