{
  "id": "mxt-common",
  "$library": true,
  "$version": "26.1.2",
  "$title": {
    "en_us": "MiXianTu Common Types",
    "zh_cn": "MiXianTu 通用类型"
  },
  "$description": {
    "en_us": "Primitives and shared value records every other MiXianTu schema builds on.",
    "zh_cn": "供其他 MiXianTu Schema 引用的基础字段类型与共用数值记录。"
  },
  "$types": {
    "number_provider": {
      "$title": {
        "en_us": "Number Provider",
        "zh_cn": "数值提供器"
      },
      "$description": {
        "en_us": "A finite number, an exp4j expression, or a typed number provider.",
        "zh_cn": "数值提供器的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Constant",
            "zh_cn": "常量"
          },
          "$description": {
            "en_us": "A finite constant number.",
            "zh_cn": "一个有限的常量数值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Expression",
            "zh_cn": "表达式"
          },
          "$description": {
            "en_us": "An exp4j expression.",
            "zh_cn": "一条 exp4j 表达式。"
          },
          "type": "string"
        },
        {
          "$type": "mxt-common#number_provider_object"
        }
      ]
    },
    "number_provider_object": {
      "$title": {
        "en_us": "Number Provider",
        "zh_cn": "数值提供器"
      },
      "$description": {
        "en_us": "Number Provider selected by a type identifier.",
        "zh_cn": "数值提供器的值。"
      },
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$title": {
            "en_us": "Type",
            "zh_cn": "类型"
          },
          "type": "string",
          "enum": [
            "mxt:constant",
            "mxt:js",
            "mxt:expression",
            "mxt:context_variable",
            "mxt:sum",
            "mxt:uniform",
            "mxt:binomial",
            "mxt:weighted_list"
          ],
          "$suggstion": true,
          "default": "mxt:constant",
          "$description": {
            "en_us": "Type value.",
            "zh_cn": "类型的值。"
          }
        }
      },
      "$variants": {
        "mxt:constant": {
          "$title": {
            "en_us": "Constant",
            "zh_cn": "常量"
          },
          "$description": {
            "en_us": "A fixed number.",
            "zh_cn": "固定数值。"
          },
          "type": "object",
          "properties": {
            "value": {
              "$title": {
                "en_us": "Value",
                "zh_cn": "值"
              },
              "$description": {
                "en_us": "Value value.",
                "zh_cn": "值的值。"
              }
            }
          },
          "required": [
            "value"
          ]
        },
        "mxt:js": {
          "$title": {
            "en_us": "Js",
            "zh_cn": "JS 表达式"
          },
          "$description": {
            "en_us": "Computed by a JavaScript callback.",
            "zh_cn": "由 JavaScript 回调计算。"
          },
          "type": "object",
          "properties": {
            "id": {
              "$title": {
                "en_us": "Id",
                "zh_cn": "标识符"
              },
              "$description": {
                "en_us": "Id value.",
                "zh_cn": "标识符的值。"
              }
            },
            "params": {
              "$title": {
                "en_us": "Params",
                "zh_cn": "参数"
              },
              "$description": {
                "en_us": "Params value.",
                "zh_cn": "参数的值。"
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "mxt:expression": {
          "$title": {
            "en_us": "Expression",
            "zh_cn": "表达式"
          },
          "$description": {
            "en_us": "Computed by an exp4j expression.",
            "zh_cn": "由 exp4j 表达式计算。"
          },
          "type": "object",
          "properties": {
            "expression": {
              "$title": {
                "en_us": "Expression",
                "zh_cn": "表达式"
              },
              "$description": {
                "en_us": "Expression value.",
                "zh_cn": "表达式的值。"
              }
            },
            "params": {
              "$title": {
                "en_us": "Params",
                "zh_cn": "参数"
              },
              "type": "object",
              "additionalProperties": {
                "$title": {
                  "en_us": "Parameter",
                  "zh_cn": "参数"
                },
                "$description": {
                  "en_us": "A named value the expression can read, keyed by the variable name.",
                  "zh_cn": "表达式可以读取的具名值，键为变量名。"
                }
              },
              "default": {},
              "$description": {
                "en_us": "Params value.",
                "zh_cn": "参数的值。"
              }
            }
          },
          "required": [
            "expression"
          ]
        },
        "mxt:context_variable": {
          "$title": {
            "en_us": "Context Variable",
            "zh_cn": "上下文变量"
          },
          "$description": {
            "en_us": "Reads a variable out of the formula context.",
            "zh_cn": "从公式上下文中读取一个变量。"
          },
          "type": "object",
          "properties": {
            "variable": {
              "$title": {
                "en_us": "Variable",
                "zh_cn": "变量"
              },
              "default": 0,
              "$description": {
                "en_us": "Variable value.",
                "zh_cn": "变量的值。"
              }
            },
            "fallback": {
              "$title": {
                "en_us": "Fallback",
                "zh_cn": "回退值"
              },
              "default": 0,
              "$description": {
                "en_us": "Fallback value.",
                "zh_cn": "回退值的值。"
              }
            }
          },
          "required": [
            "variable"
          ]
        },
        "mxt:sum": {
          "$title": {
            "en_us": "Sum",
            "zh_cn": "求和"
          },
          "$description": {
            "en_us": "Adds its terms together.",
            "zh_cn": "把各项相加。"
          },
          "type": "object",
          "properties": {
            "summands": {
              "$title": {
                "en_us": "Summands",
                "zh_cn": "加数"
              },
              "type": "array",
              "items": {
                "$title": {
                  "en_us": "Summand",
                  "zh_cn": "加数"
                },
                "$description": {
                  "en_us": "One term of the sum.",
                  "zh_cn": "求和中的一项。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Summands value.",
                "zh_cn": "加数的值。"
              }
            }
          },
          "required": [
            "summands"
          ]
        },
        "mxt:uniform": {
          "$title": {
            "en_us": "Uniform",
            "zh_cn": "均匀分布"
          },
          "$description": {
            "en_us": "A uniformly distributed random number.",
            "zh_cn": "均匀分布的随机数。"
          },
          "type": "object",
          "properties": {
            "min": {
              "$title": {
                "en_us": "Min",
                "zh_cn": "最小"
              },
              "$description": {
                "en_us": "Min value.",
                "zh_cn": "最小的值。"
              }
            },
            "max": {
              "$title": {
                "en_us": "Max",
                "zh_cn": "最大"
              },
              "$description": {
                "en_us": "Max value.",
                "zh_cn": "最大的值。"
              }
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "mxt:binomial": {
          "$title": {
            "en_us": "Binomial",
            "zh_cn": "二项分布"
          },
          "$description": {
            "en_us": "A binomially distributed random number.",
            "zh_cn": "二项分布的随机数。"
          },
          "type": "object",
          "properties": {
            "n": {
              "$title": {
                "en_us": "N",
                "zh_cn": "N"
              },
              "$description": {
                "en_us": "N value.",
                "zh_cn": "N的值。"
              }
            },
            "p": {
              "$title": {
                "en_us": "P",
                "zh_cn": "P"
              },
              "$description": {
                "en_us": "P value.",
                "zh_cn": "P的值。"
              }
            }
          },
          "required": [
            "n",
            "p"
          ]
        },
        "mxt:weighted_list": {
          "$title": {
            "en_us": "Weighted List",
            "zh_cn": "加权列表"
          },
          "$description": {
            "en_us": "Picks a weighted entry at random.",
            "zh_cn": "按权重随机挑选一项。"
          },
          "type": "object",
          "properties": {
            "distribution": {
              "$title": {
                "en_us": "Distribution",
                "zh_cn": "分布"
              },
              "type": "array",
              "items": {
                "$title": {
                  "en_us": "Share",
                  "zh_cn": "分配项"
                },
                "$description": {
                  "en_us": "One share of the distribution.",
                  "zh_cn": "分配方式中的一项。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Distribution value.",
                "zh_cn": "分布的值。"
              }
            }
          },
          "required": [
            "distribution"
          ]
        }
      }
    },
    "item_matcher": {
      "$title": {
        "en_us": "Item Matcher",
        "zh_cn": "物品匹配器"
      },
      "$description": {
        "en_us": "One item or item tag, or an array mixing both.",
        "zh_cn": "物品匹配器的值。"
      },
      "oneOf": [
        {
          "$type": "mxt-common#item_matcher_entry"
        },
        {
          "type": "array",
          "items": {
            "$type": "mxt-common#item_matcher_entry"
          }
        }
      ]
    },
    "item_matcher_entry": {
      "$title": {
        "en_us": "Item Matcher Entry",
        "zh_cn": "物品匹配器条目"
      },
      "$description": {
        "en_us": "One item identifier or one item tag prefixed with #.",
        "zh_cn": "物品匹配器条目的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Item",
            "zh_cn": "物品"
          },
          "$description": {
            "en_us": "A Minecraft item identifier.",
            "zh_cn": "一个 Minecraft 物品 ID。"
          },
          "type": "string",
          "$registry": "minecraft:item"
        },
        {
          "$title": {
            "en_us": "Item Tag",
            "zh_cn": "物品标签"
          },
          "$description": {
            "en_us": "A Minecraft item tag identifier prefixed with #.",
            "zh_cn": "以 # 开头的 Minecraft 物品标签 ID。"
          },
          "type": "string",
          "$registry": "minecraft:item_tag",
          "pattern": "^#.+"
        }
      ]
    },
    "item_quality_tag": {
      "$title": {
        "en_us": "Item Quality Tag",
        "zh_cn": "物品品质标签"
      },
      "$description": {
        "en_us": "An item quality tag identifier prefixed with #.",
        "zh_cn": "物品品质标签的值。"
      },
      "type": "string",
      "pattern": "^#.+"
    },
    "hotbar_icon": {
      "$title": {
        "en_us": "Hotbar Icon",
        "zh_cn": "快捷栏图标"
      },
      "$description": {
        "en_us": "Exactly one 16x16 texture or one item stack template rendered in an Mxt hotbar slot.",
        "zh_cn": "快捷栏槽位图标，必须且只能指定一个 16x16 贴图或一个物品堆栈模板。"
      },
      "type": "object",
      "properties": {
        "texture": {
          "$title": {
            "en_us": "Texture",
            "zh_cn": "贴图"
          },
          "type": "string",
          "$description": {
            "en_us": "A 16x16 texture identifier, including the textures/ path and .png suffix.",
            "zh_cn": "16x16 贴图标识符，需包含 textures/ 路径及 .png 后缀。"
          }
        },
        "item": {
          "$title": {
            "en_us": "Item",
            "zh_cn": "物品"
          },
          "$description": {
            "en_us": "An ItemStack template rendered with the vanilla item renderer.",
            "zh_cn": "使用原版物品渲染器绘制的 ItemStack 模板。"
          },
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "$registry": "minecraft:item",
              "$title": {
                "en_us": "Id",
                "zh_cn": "标识符"
              },
              "$description": {
                "en_us": "Id value.",
                "zh_cn": "标识符的值。"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99,
              "default": 1,
              "$title": {
                "en_us": "Count",
                "zh_cn": "数量"
              },
              "$description": {
                "en_us": "Count value.",
                "zh_cn": "数量的值。"
              }
            },
            "components": {
              "type": "object",
              "$title": {
                "en_us": "Components",
                "zh_cn": "组件"
              },
              "$description": {
                "en_us": "Components value.",
                "zh_cn": "组件的值。"
              }
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "texture"
          ]
        },
        {
          "required": [
            "item"
          ]
        }
      ]
    },
    "aura_maximum": {
      "$title": {
        "en_us": "Aura Maximum",
        "zh_cn": "灵气上限"
      },
      "$description": {
        "en_us": "A fixed environmental capacity, an initial-aura multiplier, or no limit.",
        "zh_cn": "固定环境容量、初始灵气倍数或无限制。"
      },
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "$title": {
            "en_us": "Typed Maximum",
            "zh_cn": "具名上限"
          },
          "$description": {
            "en_us": "The written-out form: a fixed capacity, a multiple of the initial aura, or no limit at all.",
            "zh_cn": "完整写法：固定容量、初始灵气的倍数，或完全不限。"
          },
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "mxt:fixed",
                "mxt:initial_multiplier",
                "mxt:unlimited"
              ],
              "default": "mxt:fixed",
              "$title": {
                "en_us": "Type",
                "zh_cn": "类型"
              },
              "$description": {
                "en_us": "Which form this maximum takes. mxt:fixed reads value, mxt:initial_multiplier reads multiplier, and mxt:unlimited reads neither.",
                "zh_cn": "上限的形式。mxt:fixed 读 value，mxt:initial_multiplier 读 multiplier，mxt:unlimited 两者都不读。"
              }
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "$title": {
                "en_us": "Value",
                "zh_cn": "数值"
              },
              "$description": {
                "en_us": "Fixed capacity, used by mxt:fixed. Must not be negative.",
                "zh_cn": "固定容量，供 mxt:fixed 使用。不能为负数。"
              }
            },
            "multiplier": {
              "type": "number",
              "minimum": 0,
              "default": 1,
              "$title": {
                "en_us": "Multiplier",
                "zh_cn": "倍率"
              },
              "$description": {
                "en_us": "Multiple of the initial aura, used by mxt:initial_multiplier. Defaults to 1.",
                "zh_cn": "初始灵气的倍数，供 mxt:initial_multiplier 使用。默认 1。"
              }
            }
          }
        }
      ]
    },
    "record_ResourceCost": {
      "$title": {
        "en_us": "ResourceCost",
        "zh_cn": "资源消耗"
      },
      "$description": {
        "en_us": "ResourceCost value.",
        "zh_cn": "资源消耗的值。"
      },
      "type": "object",
      "properties": {
        "id": {
          "$title": {
            "en_us": "Id",
            "zh_cn": "标识符"
          },
          "type": "string",
          "$registry": "mxt:resource",
          "$description": {
            "en_us": "Id value.",
            "zh_cn": "标识符的值。"
          }
        },
        "amount": {
          "$title": {
            "en_us": "Amount",
            "zh_cn": "数量"
          },
          "$type": "mxt-common#number_provider",
          "$description": {
            "en_us": "Amount value.",
            "zh_cn": "数量的值。"
          }
        }
      },
      "required": [
        "id",
        "amount"
      ]
    },
    "record_AuraValue": {
      "$title": {
        "en_us": "AuraValue",
        "zh_cn": "灵气数值"
      },
      "$description": {
        "en_us": "One resource's aura entry: how much, its cap, its regeneration and the colour used when rendering it.",
        "zh_cn": "某一种资源的灵气条目：数量、上限、恢复速度，以及渲染时使用的颜色。"
      },
      "type": "object",
      "properties": {
        "amount": {
          "$title": {
            "en_us": "Amount",
            "zh_cn": "数量"
          },
          "type": "number",
          "minimum": 0,
          "default": 0,
          "$description": {
            "en_us": "Initial stock, or this block's capacity contribution. Must not be negative.",
            "zh_cn": "初始存量，或本方块的容量贡献。不能为负数。"
          }
        },
        "max": {
          "$title": {
            "en_us": "Max",
            "zh_cn": "最大值"
          },
          "$type": "mxt-common#aura_maximum",
          "$description": {
            "en_us": "Cap for this resource. Omit it for the default multiplier of one.",
            "zh_cn": "该资源的上限。省略即使用默认倍率 1。"
          }
        },
        "regen_per_tick": {
          "$title": {
            "en_us": "Regen Per Tick",
            "zh_cn": "每刻恢复量"
          },
          "type": "number",
          "default": 0,
          "$description": {
            "en_us": "How much of this resource regenerates per game tick.",
            "zh_cn": "该资源每游戏刻恢复的数量。"
          }
        },
        "color": {
          "$title": {
            "en_us": "Color",
            "zh_cn": "颜色"
          },
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215,
              "default": 16777215,
              "$title": {
                "en_us": "Decimal Color",
                "zh_cn": "十进制颜色"
              },
              "$description": {
                "en_us": "The color as a 24-bit decimal number.",
                "zh_cn": "颜色的 24 位十进制数值。"
              }
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "$title": {
                "en_us": "Hex Color",
                "zh_cn": "十六进制颜色"
              },
              "$description": {
                "en_us": "The color as #RRGGBB. No alpha channel.",
                "zh_cn": "写成 #RRGGBB 的颜色。不含透明度。"
              }
            }
          ],
          "$description": {
            "en_us": "Colour used by environment rendering. Particles and HUD bars keep their own colours.",
            "zh_cn": "环境渲染使用的颜色。粒子与 HUD 条使用各自的颜色。"
          }
        }
      }
    },
    "record_ApplyCurseAction": {
      "$title": {
        "en_us": "ApplyCurseAction",
        "zh_cn": "施加诅咒条目"
      },
      "$description": {
        "en_us": "One curse applied by the apply_curses action.",
        "zh_cn": "施加诅咒行为中的一条诅咒配置。"
      },
      "type": "object",
      "properties": {
        "curse": {
          "$title": {
            "en_us": "Curse",
            "zh_cn": "诅咒"
          },
          "type": "string",
          "$registry": "mxt:curse",
          "$description": {
            "en_us": "Curse to apply.",
            "zh_cn": "要施加的诅咒。"
          }
        },
        "stacks": {
          "$title": {
            "en_us": "Stacks",
            "zh_cn": "层数"
          },
          "$type": "mxt-common#number_provider",
          "default": 1,
          "$description": {
            "en_us": "How many stacks to apply, evaluated through the formula context. Defaults to 1.",
            "zh_cn": "施加的层数，通过公式上下文求值，默认 1。"
          }
        },
        "duration_ticks": {
          "$title": {
            "en_us": "Duration Ticks",
            "zh_cn": "持续刻数"
          },
          "$type": "mxt-common#number_provider",
          "$description": {
            "en_us": "How long the curse lasts, in ticks. Omit it for the curse's own default duration.",
            "zh_cn": "诅咒持续时间，单位 tick。省略即使用诅咒自身的默认时长。"
          }
        }
      },
      "required": [
        "curse"
      ]
    },
    "record_AttributeEntry": {
      "$title": {
        "en_us": "AttributeEntry",
        "zh_cn": "属性修正"
      },
      "$description": {
        "en_us": "AttributeEntry value.",
        "zh_cn": "属性修正的值。"
      },
      "type": "object",
      "properties": {
        "attribute": {
          "$title": {
            "en_us": "Attribute",
            "zh_cn": "属性"
          },
          "$description": {
            "en_us": "Attribute value.",
            "zh_cn": "属性的值。"
          }
        },
        "id": {
          "$title": {
            "en_us": "Modifier Id",
            "zh_cn": "修正器标识符"
          },
          "type": "string",
          "$description": {
            "en_us": "Vanilla modifier identifier.",
            "zh_cn": "原版属性修正器的标识符。"
          }
        },
        "amount": {
          "$title": {
            "en_us": "Amount",
            "zh_cn": "数量"
          },
