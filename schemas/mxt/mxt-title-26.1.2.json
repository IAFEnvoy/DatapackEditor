{
  "$title": {
    "en_us": "MiXianTu Title",
    "zh_cn": "觅仙途称号"
  },
  "$description": {
    "en_us": "Data-driven Title definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的称号定义。"
  },
  "type": "object",
  "properties": {
    "unlock_condition": {
      "$title": {
        "en_us": "Unlock Condition",
        "zh_cn": "解锁条件"
      },
      "$type": "mxt-common-entity-condition#entity_condition",
      "$description": {
        "en_us": "Condition a player has to meet to unlock the title.",
        "zh_cn": "解锁该称号需要满足的条件。"
      }
    },
    "priority": {
      "$title": {
        "en_us": "Priority",
        "zh_cn": "优先级"
      },
      "type": "integer",
      "default": 0,
      "$description": {
        "en_us": "Order used when several titles could apply at once.",
        "zh_cn": "多个称号同时可用时的优先顺序。"
      }
    },
    "passive_modifiers": {
      "$title": {
        "en_us": "Passive Modifiers",
        "zh_cn": "被动修正"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common#record_AttributeEntry",
        "$title": {
          "en_us": "Modifier",
          "zh_cn": "属性修正"
        },
        "$description": {
          "en_us": "One attribute modifier.",
          "zh_cn": "一条属性修正。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Attribute modifiers granted while the title is worn.",
        "zh_cn": "佩戴该称号时提供的属性修改。"
      }
    },
    "exclusive_tags": {
      "$title": {
        "en_us": "Exclusive Tags",
        "zh_cn": "互斥标签"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Tag",
          "zh_cn": "标签"
        },
        "$description": {
          "en_us": "One tag id.",
          "zh_cn": "一个标签 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Tags that make titles mutually exclusive.",
        "zh_cn": "称号之间互斥的标签。"
      }
    },
    "maximum_level": {
      "$title": {
        "en_us": "Maximum Level",
        "zh_cn": "最大等级"
      },
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 1,
      "$description": {
        "en_us": "Highest level this title can reach, 1 to 1000.",
        "zh_cn": "该称号可达到的最高等级，范围 1..1000。"
      }
    }
  },
  "id": "mxt-title",
  "$version": "26.1.2",
  "$registry": "mxt:title",
  "$path": "data/<namespace>/mxt/title/<path>.json"
}
