{
  "$title": {
    "en_us": "MiXianTu Item Archetype",
    "zh_cn": "觅仙途法器与物品原型"
  },
  "$description": {
    "en_us": "Data-driven Item Archetype definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的法器与物品原型定义。"
  },
  "type": "object",
  "properties": {
    "item_type": {
      "$title": {
        "en_us": "Item Type",
        "zh_cn": "物品类型"
      },
      "$description": {
        "en_us": "Archetype of item this definition applies to.",
        "zh_cn": "该定义适用的物品原型类型。"
      }
    },
    "spirit_capacity": {
      "$title": {
        "en_us": "Spirit Capacity",
        "zh_cn": "灵力容量"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "How much aura the item can store.",
        "zh_cn": "该物品可以储存的灵气上限。"
      }
    },
    "storage_slots": {
      "$title": {
        "en_us": "Storage Slots",
        "zh_cn": "储物槽位"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Number of storage slots the item exposes.",
        "zh_cn": "该物品提供的储物槽位数量。"
      }
    },
    "flight_speed": {
      "$title": {
        "en_us": "Flight Speed",
        "zh_cn": "飞行速度"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Flight speed granted while the item is worn.",
        "zh_cn": "装备该物品时提供的飞行速度。"
      }
    },
    "flight_costs": {
      "$title": {
        "en_us": "Flight Costs",
        "zh_cn": "飞行消耗"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common#record_ResourceCost",
        "$title": {
          "en_us": "Cost",
          "zh_cn": "消耗"
        },
        "$description": {
          "en_us": "One cost paid while flying.",
          "zh_cn": "飞行时支付的一项消耗。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Resources paid per tick while flying.",
        "zh_cn": "飞行时每刻支付的资源。"
      }
    },
    "granted_abilities": {
      "$title": {
        "en_us": "Granted Abilities",
        "zh_cn": "授予的技能"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$registry": "mxt:ability",
        "$title": {
          "en_us": "Ability",
          "zh_cn": "技能"
        },
        "$description": {
          "en_us": "One ability id.",
          "zh_cn": "一个技能 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Abilities granted while the item is equipped.",
        "zh_cn": "装备该物品时授予的技能。"
      }
    },
    "refine_action": {
      "$title": {
        "en_us": "Refine Action",
        "zh_cn": "炼化行为"
      },
      "type": "object",
      "$description": {
        "en_us": "Action run when the item is refined.",
        "zh_cn": "炼化该物品时执行的行为。"
      }
    }
  },
  "required": [
    "item_type"
  ],
  "id": "mxt-item_archetype",
  "$version": "26.1.2",
  "$registry": "mxt:item_archetype",
  "$path": "data/<namespace>/mxt/item_archetype/<path>.json"
}
