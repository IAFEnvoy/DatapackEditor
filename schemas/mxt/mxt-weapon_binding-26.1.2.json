{
  "$title": {
    "en_us": "MiXianTu Weapon Binding",
    "zh_cn": "觅仙途武器绑定"
  },
  "$description": {
    "en_us": "Data-driven Weapon Binding definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的武器绑定定义。"
  },
  "type": "object",
  "properties": {
    "items": {
      "$title": {
        "en_us": "Items",
        "zh_cn": "物品"
      },
      "$type": "mxt-common#item_matcher",
      "$description": {
        "en_us": "Weapons this binding applies to.",
        "zh_cn": "该绑定适用的武器。"
      }
    },
    "attack_damage": {
      "$title": {
        "en_us": "Attack Damage",
        "zh_cn": "攻击伤害"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Attack damage granted by the weapon.",
        "zh_cn": "该武器提供的攻击伤害。"
      }
    },
    "attack_speed": {
      "$title": {
        "en_us": "Attack Speed",
        "zh_cn": "攻击速度"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Attack speed granted by the weapon.",
        "zh_cn": "该武器提供的攻击速度。"
      }
    },
    "attributes": {
      "$title": {
        "en_us": "Attributes",
        "zh_cn": "属性"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common#record_AttributeEntry",
        "$title": {
          "en_us": "Attribute",
          "zh_cn": "属性"
        },
        "$description": {
          "en_us": "One attribute entry.",
          "zh_cn": "一条属性条目。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Attribute entries granted by the weapon.",
        "zh_cn": "该武器提供的属性条目。"
      }
    },
    "use_action": {
      "$title": {
        "en_us": "Use Action",
        "zh_cn": "使用行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the weapon is used.",
        "zh_cn": "使用该武器时执行的行为。"
      }
    },
    "attack_action": {
      "$title": {
        "en_us": "Attack Action",
        "zh_cn": "攻击行为"
      },
      "$type": "mxt-common-bi-entity-action#bi_entity_action",
      "$description": {
        "en_us": "Action run when the weapon hits.",
        "zh_cn": "该武器命中时执行的行为。"
      }
    },
    "tick_action": {
      "$title": {
        "en_us": "Tick Action",
        "zh_cn": "周期行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run on every tick while the weapon is held.",
        "zh_cn": "持有该武器时每刻执行的行为。"
      }
    },
    "quality_group": {
      "$title": {
        "en_us": "Quality Group",
        "zh_cn": "品质组"
      },
      "$type": "mxt-common#item_quality_tag",
      "$description": {
        "en_us": "Quality group shared by these weapons.",
        "zh_cn": "这些武器共用的品质组。"
      }
    },
    "condition": {
      "$title": {
        "en_us": "Condition",
        "zh_cn": "条件"
      },
      "$type": "mxt-common-entity-condition#entity_condition",
      "$description": {
        "en_us": "Condition a weapon has to meet for the binding to apply.",
        "zh_cn": "武器需要满足的条件，满足后该绑定才生效。"
      }
    }
  },
  "required": [
    "items"
  ],
  "id": "mxt-weapon_binding",
  "$version": "26.1.2",
  "$registry": "mxt:weapon_binding",
  "$path": "data/<namespace>/mxt/weapon_binding/<path>.json"
}
