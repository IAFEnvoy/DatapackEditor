{
  "$title": {
    "en_us": "MiXianTu Talisman",
    "zh_cn": "觅仙途符箓"
  },
  "$description": {
    "en_us": "Data-driven Talisman definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的符箓定义。"
  },
  "type": "object",
  "properties": {
    "name": {
      "$title": {
        "en_us": "Name",
        "zh_cn": "名称"
      },
      "$description": {
        "en_us": "Name of this Talisman.",
        "zh_cn": "名称的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "description": {
      "$title": {
        "en_us": "Description",
        "zh_cn": "描述"
      },
      "$description": {
        "en_us": "Description of this Talisman.",
        "zh_cn": "描述的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "abilities": {
      "$title": {
        "en_us": "Abilities",
        "zh_cn": "技能"
      },
      "$description": {
        "en_us": "Abilities of this Talisman.",
        "zh_cn": "技能的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Identifier",
            "zh_cn": "标识符"
          },
          "$description": {
            "en_us": "One accepted form of this value: identifier.",
            "zh_cn": "标识符的值。"
          },
          "type": "string",
          "$registry": "mxt:ability"
        },
        {
          "$title": {
            "en_us": "Tag",
            "zh_cn": "标签"
          },
          "$description": {
            "en_us": "One accepted form of this value: tag.",
            "zh_cn": "标签的值。"
          },
          "type": "string",
          "$registry": "mxt:ability_tag",
          "pattern": "^#.+"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$title": {
                  "en_us": "Identifier",
                  "zh_cn": "标识符"
                },
                "$description": {
                  "en_us": "One accepted form of this value: identifier.",
                  "zh_cn": "标识符的值。"
                },
                "type": "string",
                "$registry": "mxt:ability"
              },
              {
                "$title": {
                  "en_us": "Tag",
                  "zh_cn": "标签"
                },
                "$description": {
                  "en_us": "One accepted form of this value: tag.",
                  "zh_cn": "标签的值。"
                },
                "type": "string",
                "$registry": "mxt:ability_tag",
                "pattern": "^#.+"
              }
            ],
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "aura_cost": {
      "$title": {
        "en_us": "Aura Cost",
        "zh_cn": "灵气消耗"
      },
      "$description": {
        "en_us": "Aura Cost of this Talisman.",
        "zh_cn": "灵气消耗的值。"
      },
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$title": {
              "en_us": "Text",
              "zh_cn": "文本"
            },
            "$description": {
              "en_us": "One accepted form of this value: text.",
              "zh_cn": "文本的值。"
            },
            "type": "string"
          },
          {
            "$title": {
              "en_us": "Number",
              "zh_cn": "数值"
            },
            "$description": {
              "en_us": "One accepted form of this value: number.",
              "zh_cn": "数值的值。"
            },
            "type": "number"
          },
          {
            "$title": {
              "en_us": "Number Provider",
              "zh_cn": "数值提供器"
            },
            "$description": {
              "en_us": "One accepted form of this value: number provider.",
              "zh_cn": "数值提供器的值。"
            },
            "$type": "mxt-common#number_provider"
          }
        ],
        "$title": {
          "en_us": "Property",
          "zh_cn": "条目"
        },
        "$description": {
          "en_us": "Property value.",
          "zh_cn": "条目的值。"
        }
      }
    }
  },
  "id": "mxt-talisman",
  "$version": "26.1.2",
  "$registry": "mxt:talisman",
  "$path": "data/<namespace>/mxt/talisman/<path>.json"
}
