{
  "$title": {
    "en_us": "MiXianTu Currency",
    "zh_cn": "觅仙途货币价值"
  },
  "$description": {
    "en_us": "Data-driven Currency definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的货币面额与兑换价值定义。"
  },
  "type": "object",
  "properties": {
    "items": {
      "$title": {
        "en_us": "Items",
        "zh_cn": "物品"
      },
      "$type": "mxt-common#item_matcher",
      "$description": {
        "en_us": "Items this currency definition covers.",
        "zh_cn": "该货币定义覆盖的物品。"
      }
    },
    "item": {
      "$title": {
        "en_us": "Item",
        "zh_cn": "物品"
      },
      "type": "string",
      "$description": {
        "en_us": "The item of one currency entry.",
        "zh_cn": "单个货币条目对应的物品。"
      }
    },
    "value": {
      "$title": {
        "en_us": "Value",
        "zh_cn": "值"
      },
      "type": "integer",
      "$description": {
        "en_us": "Worth of one unit, used when currencies are exchanged.",
        "zh_cn": "一单位该货币的价值，用于兑换换算。"
      }
    },
    "exchanges": {
      "$title": {
        "en_us": "Exchanges",
        "zh_cn": "兑换项目"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-content#record_Exchange",
        "$title": {
          "en_us": "Exchange",
          "zh_cn": "兑换项"
        },
        "$description": {
          "en_us": "One exchange entry.",
          "zh_cn": "一个兑换项。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Currency exchange entries.",
        "zh_cn": "可进行的货币兑换项。"
      }
    }
  },
  "required": [
    "value",
    "exchanges"
  ],
  "id": "mxt-currency",
  "$version": "26.1.2",
  "$registry": "mxt:currency",
  "$path": "data/<namespace>/mxt/currency/<path>.json"
}
