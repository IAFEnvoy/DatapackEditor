          "type": "number",
          "default": 0.5,
          "$description": {
            "en_us": "Offset Y value.",
            "zh_cn": "Y 轴偏移的值。"
          }
        },
        "offset_z": {
          "$title": {
            "en_us": "Offset Z",
            "zh_cn": "Z 轴偏移"
          },
          "type": "number",
          "default": 0,
          "$description": {
            "en_us": "Offset Z value.",
            "zh_cn": "Z 轴偏移的值。"
          }
        }
      },
      "required": [
        "particle"
      ]
    },
