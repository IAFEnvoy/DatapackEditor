{
  "id": "mxt-common-aura",
  "$library": true,
  "$version": "26.1.2",
  "$title": {
    "en_us": "MiXianTu Aura And Display",
    "zh_cn": "MiXianTu 灵气与显示"
  },
  "$description": {
    "en_us": "Aura field records, client render and HUD settings, particles and badges.",
    "zh_cn": "灵气场记录、客户端渲染与 HUD 设置、粒子与徽章。"
  },
  "$types": {
    "badge": {
      "$title": {
        "en_us": "Badge",
        "zh_cn": "徽章"
      },
      "$description": {
        "en_us": "Badge selected by a type identifier.",
        "zh_cn": "徽章的值。"
      },
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$title": {
            "en_us": "Type",
            "zh_cn": "类型"
          },
          "type": "string",
          "enum": [
            "mxt:empty",
            "mxt:crafting_recipe",
            "mxt:keybind",
            "mxt:sprite",
            "mxt:tooltip"
          ],
          "$suggstion": true,
          "default": "mxt:empty",
          "$description": {
            "en_us": "Type value.",
            "zh_cn": "类型的值。"
          }
        }
      },
      "$variants": {
        "mxt:empty": {
          "$title": {
            "en_us": "Empty",
            "zh_cn": "空"
          },
          "$description": {
            "en_us": "Shows only the icon.",
            "zh_cn": "只显示图标，不带附加说明。"
          },
          "type": "object",
          "properties": {}
        },
        "mxt:crafting_recipe": {
          "$title": {
            "en_us": "Crafting Recipe",
            "zh_cn": "工作台配方"
          },
          "$description": {
            "en_us": "Points at a crafting recipe.",
            "zh_cn": "指向一条工作台配方。"
          },
          "type": "object",
          "properties": {
            "sprite": {
              "$title": {
                "en_us": "Sprite",
                "zh_cn": "精灵图"
              },
              "type": "string",
              "$description": {
                "en_us": "Sprite value.",
                "zh_cn": "精灵图的值。"
              }
            },
            "recipe": {
              "$title": {
                "en_us": "Recipe",
                "zh_cn": "配方"
              },
              "type": "string",
              "default": false,
              "$description": {
                "en_us": "Recipe value.",
                "zh_cn": "配方的值。"
              }
            },
            "from_power": {
              "$title": {
                "en_us": "From Power",
                "zh_cn": "来自能力"
              },
              "type": "boolean",
              "default": false,
              "$description": {
                "en_us": "From Power value.",
                "zh_cn": "来自能力的值。"
              }
            },
            "prefix": {
              "$title": {
                "en_us": "Prefix",
                "zh_cn": "前缀"
              },
              "$description": {
                "en_us": "Prefix value.",
                "zh_cn": "前缀的值。"
              }
            },
            "suffix": {
              "$title": {
                "en_us": "Suffix",
                "zh_cn": "后缀"
              },
              "$description": {
                "en_us": "Suffix value.",
                "zh_cn": "后缀的值。"
              }
            }
          },
          "required": [
            "sprite",
            "recipe"
          ]
        },
        "mxt:keybind": {
          "$title": {
            "en_us": "Keybind",
            "zh_cn": "按键"
          },
          "$description": {
            "en_us": "Shows a keybind hint.",
            "zh_cn": "显示按键提示。"
          },
          "type": "object",
          "properties": {
            "sprite": {
              "$title": {
                "en_us": "Sprite",
                "zh_cn": "精灵图"
              },
              "type": "string",
              "default": "",
              "$description": {
                "en_us": "Sprite value.",
                "zh_cn": "精灵图的值。"
              }
            },
            "text": {
              "$title": {
                "en_us": "Text",
                "zh_cn": "文本"
              },
              "default": "",
              "$description": {
                "en_us": "Text value.",
                "zh_cn": "文本的值。"
              }
            },
            "key": {
              "$title": {
                "en_us": "Key",
                "zh_cn": "键"
              },
              "default": "key.mxt.primary_active",
              "$description": {
                "en_us": "Key value.",
                "zh_cn": "键的值。"
              }
            }
          },
          "required": [
            "sprite"
          ]
        },
        "mxt:sprite": {
          "$title": {
            "en_us": "Sprite",
            "zh_cn": "精灵图"
          },
          "$description": {
            "en_us": "Shows a sprite.",
            "zh_cn": "显示一张精灵图。"
          },
          "type": "object",
          "properties": {
            "sprite": {
              "$title": {
                "en_us": "Sprite",
                "zh_cn": "精灵图"
              },
              "type": "string",
              "$description": {
                "en_us": "Sprite value.",
                "zh_cn": "精灵图的值。"
              }
            }
          },
          "required": [
            "sprite"
          ]
        },
        "mxt:tooltip": {
          "$title": {
            "en_us": "Tooltip",
            "zh_cn": "提示文本"
          },
          "$description": {
            "en_us": "Adds a tooltip line.",
            "zh_cn": "增加一行提示文本。"
          },
          "type": "object",
          "properties": {
            "sprite": {
              "$title": {
                "en_us": "Sprite",
                "zh_cn": "精灵图"
              },
              "type": "string",
              "$description": {
                "en_us": "Sprite value.",
                "zh_cn": "精灵图的值。"
              }
            },
            "text": {
              "$title": {
                "en_us": "Text",
                "zh_cn": "文本"
              },
              "$description": {
                "en_us": "Text value.",
                "zh_cn": "文本的值。"
              }
            }
          },
          "required": [
            "sprite"
          ]
        }
      }
    },
    "record_ParticleEffect": {
      "$title": {
        "en_us": "ParticleEffect",
        "zh_cn": "粒子效果"
      },
      "$description": {
        "en_us": "ParticleEffect value.",
        "zh_cn": "粒子效果的值。"
      },
      "type": "object",
      "properties": {
        "particle": {
          "$title": {
            "en_us": "Particle",
            "zh_cn": "粒子"
          },
          "default": 16,
          "$description": {
            "en_us": "Particle value.",
            "zh_cn": "粒子的值。"
          }
        },
        "count": {
          "$title": {
            "en_us": "Count",
            "zh_cn": "数量"
          },
          "type": "integer",
          "default": 16,
          "$description": {
            "en_us": "Count value.",
            "zh_cn": "数量的值。"
          }
        },
        "speed": {
          "$title": {
            "en_us": "Speed",
            "zh_cn": "速度"
          },
          "type": "number",
          "default": 0,
          "$description": {
            "en_us": "Speed value.",
            "zh_cn": "速度的值。"
          }
        },
        "force": {
          "$title": {
            "en_us": "Force",
            "zh_cn": "强制"
          },
          "type": "boolean",
          "default": false,
          "$description": {
            "en_us": "Force value.",
            "zh_cn": "强制的值。"
          }
        },
        "spread": {
          "$title": {
            "en_us": "Spread",
            "zh_cn": "扩散"
          },
          "$description": {
            "en_us": "Spread value.",
            "zh_cn": "扩散的值。"
          }
        },
        "offset_x": {
          "$title": {
            "en_us": "Offset X",
            "zh_cn": "X 轴偏移"
