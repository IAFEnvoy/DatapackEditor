          "type": "number",
          "default": 0,
          "$description": {
            "en_us": "Offset X value.",
            "zh_cn": "X 轴偏移的值。"
          }
        },
        "offset_y": {
          "$title": {
            "en_us": "Offset Y",
            "zh_cn": "Y 轴偏移"
