{
  "id": "mxt-common-block-action",
  "$library": true,
  "$version": "26.1.2",
  "$title": {
    "en_us": "MiXianTu Block Actions",
    "zh_cn": "MiXianTu 方块行为"
  },
  "$description": {
    "en_us": "Actions performed on a block.",
    "zh_cn": "对方块执行的行为。"
  },
  "$types": {
    "block_action": {
      "$title": {
        "en_us": "Block Action",
        "zh_cn": "方块行为"
      },
      "$description": {
        "en_us": "Block Action selected by a type identifier.",
        "zh_cn": "方块行为的值。"
      },
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$title": {
            "en_us": "Type",
            "zh_cn": "类型"
          },
          "type": "string",
          "enum": [
            "mxt:no_op",
            "mxt:js",
            "mxt:sequence",
            "mxt:set_block",
            "mxt:break_block",
            "mxt:change_aura",
            "mxt:schedule_tick",
            "mxt:bonemeal",
            "mxt:light_up",
            "mxt:chance",
            "mxt:if_else",
            "mxt:choice",
            "mxt:offset",
            "mxt:explode",
            "mxt:spawn_entity"
          ],
          "$suggstion": true,
          "default": "mxt:no_op",
          "$description": {
            "en_us": "Type value.",
            "zh_cn": "类型的值。"
          }
        }
      },
      "$variants": {
        "mxt:no_op": {
          "$title": {
            "en_us": "No Op",
            "zh_cn": "无操作"
          },
          "$description": {
            "en_us": "Does nothing.",
            "zh_cn": "什么也不做。"
          },
          "type": "object",
          "properties": {}
        },
        "mxt:js": {
          "$title": {
            "en_us": "Js",
            "zh_cn": "JS 表达式"
          },
          "$description": {
            "en_us": "Runs a JavaScript callback with the block.",
            "zh_cn": "以该方块为参数执行 JavaScript 回调。"
          },
          "type": "object",
          "properties": {
            "id": {
              "$title": {
                "en_us": "Id",
                "zh_cn": "标识符"
              },
              "$description": {
                "en_us": "Id value.",
                "zh_cn": "标识符的值。"
              }
            },
            "params": {
              "$title": {
                "en_us": "Params",
                "zh_cn": "参数"
              },
              "$description": {
                "en_us": "Params value.",
                "zh_cn": "参数的值。"
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "mxt:sequence": {
          "$title": {
            "en_us": "Sequence",
            "zh_cn": "顺序"
          },
          "$description": {
            "en_us": "Runs several actions in order.",
            "zh_cn": "按顺序执行多个行为。"
          },
          "type": "object",
          "properties": {
            "actions": {
              "$title": {
                "en_us": "Actions",
                "zh_cn": "行为"
              },
              "type": "array",
              "items": {
                "$type": "mxt-common-block-action#block_action",
                "$title": {
                  "en_us": "Action",
                  "zh_cn": "行为"
                },
                "$description": {
                  "en_us": "One child action.",
                  "zh_cn": "一个子行为。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Actions value.",
                "zh_cn": "行为的值。"
              }
            }
          },
          "required": [
            "actions"
          ]
        },
        "mxt:set_block": {
          "$title": {
            "en_us": "Set Block",
            "zh_cn": "设置方块"
          },
          "$description": {
            "en_us": "Places a block.",
            "zh_cn": "放置一个方块。"
          },
          "type": "object",
          "properties": {
            "block": {
              "$title": {
                "en_us": "Block",
                "zh_cn": "方块"
              },
              "type": "string",
              "$description": {
                "en_us": "Block value.",
                "zh_cn": "方块的值。"
              }
            }
          },
          "required": [
            "block"
          ]
        },
        "mxt:break_block": {
          "$title": {
            "en_us": "Break Block",
            "zh_cn": "破坏方块"
          },
          "$description": {
            "en_us": "Breaks the block.",
            "zh_cn": "破坏该方块。"
          },
          "type": "object",
          "properties": {
            "drop": {
              "$title": {
                "en_us": "Drop",
                "zh_cn": "掉落"
              },
              "type": "boolean",
              "$description": {
                "en_us": "Drop value.",
                "zh_cn": "掉落的值。"
              }
            }
          }
        },
        "mxt:change_aura": {
          "$title": {
            "en_us": "Change Aura",
            "zh_cn": "改变灵气"
          },
          "$description": {
            "en_us": "Adds to or removes from the block's aura.",
            "zh_cn": "增加或移除该方块的灵气。"
          },
          "type": "object",
          "properties": {
            "amount": {
              "$title": {
                "en_us": "Amount",
                "zh_cn": "数量"
              },
              "$type": "mxt-common#number_provider",
              "$description": {
                "en_us": "Amount value.",
                "zh_cn": "数量的值。"
              }
            }
          },
          "required": [
            "amount"
          ]
        },
        "mxt:schedule_tick": {
          "$title": {
            "en_us": "Schedule Tick",
            "zh_cn": "计划刻"
          },
          "$description": {
            "en_us": "Schedules a block tick.",
            "zh_cn": "为该方块安排一次计划刻。"
          },
          "type": "object",
          "properties": {
            "delay": {
              "$title": {
                "en_us": "Delay",
                "zh_cn": "延迟"
              },
              "type": "integer",
              "$description": {
                "en_us": "Delay value.",
                "zh_cn": "延迟的值。"
              }
            }
          },
          "required": [
            "delay"
          ]
        },
        "mxt:bonemeal": {
          "$title": {
            "en_us": "Bonemeal",
            "zh_cn": "骨粉"
          },
          "$description": {
            "en_us": "Applies bonemeal to the block.",
            "zh_cn": "对该方块使用骨粉效果。"
          },
          "type": "object",
          "properties": {
            "effect": {
              "$title": {
                "en_us": "Effect",
                "zh_cn": "效果"
              },
              "type": "boolean",
              "$description": {
                "en_us": "Effect value.",
                "zh_cn": "效果的值。"
              }
            }
          }
        },
        "mxt:light_up": {
          "$title": {
            "en_us": "Light Up",
            "zh_cn": "点亮"
          },
          "$description": {
            "en_us": "Lights the area up.",
            "zh_cn": "点亮该区域。"
          },
          "type": "object",
          "properties": {}
        },
        "mxt:chance": {
          "$title": {
            "en_us": "Chance",
            "zh_cn": "概率"
          },
          "$description": {
            "en_us": "Runs the child action with the given probability.",
            "zh_cn": "按给定概率执行子行为。"
          },
          "type": "object",
          "properties": {
            "action": {
              "$title": {
                "en_us": "Action",
                "zh_cn": "行为"
              },
              "$type": "mxt-common-block-action#block_action",
              "$description": {
                "en_us": "Action value.",
                "zh_cn": "行为的值。"
              }
            },
            "chance": {
              "$title": {
                "en_us": "Chance",
                "zh_cn": "概率"
              },
              "type": "number",
              "$description": {
                "en_us": "Chance value.",
                "zh_cn": "概率的值。"
              }
            },
            "fail_action": {
              "$title": {
                "en_us": "Fail Action",
                "zh_cn": "失败行为"
              },
              "$type": "mxt-common-block-action#block_action",
              "$description": {
                "en_us": "Fail Action value.",
                "zh_cn": "失败行为的值。"
              }
            }
          },
          "required": [
            "action",
            "chance"
          ]
        },
        "mxt:if_else": {
          "$title": {
            "en_us": "If Else",
            "zh_cn": "条件分支"
          },
          "$description": {
            "en_us": "Runs one of two actions, depending on a condition.",
            "zh_cn": "按条件在两个行为中选择一个执行。"
          },
          "type": "object",
          "properties": {
            "condition": {
              "$title": {
                "en_us": "Condition",
                "zh_cn": "条件"
              },
              "$type": "mxt-common-block-condition#block_condition",
              "$description": {
                "en_us": "Condition value.",
                "zh_cn": "条件的值。"
              }
            },
            "if_action": {
              "$title": {
                "en_us": "If Action",
                "zh_cn": "条件成立行为"
              },
              "$type": "mxt-common-block-action#block_action",
              "$description": {
                "en_us": "If Action value.",
                "zh_cn": "条件成立行为的值。"
              }
            },
            "else_action": {
              "$title": {
                "en_us": "Else Action",
                "zh_cn": "否则行为"
              },
              "$type": "mxt-common-block-action#block_action",
              "$description": {
                "en_us": "Else Action value.",
                "zh_cn": "否则行为的值。"
              }
            }
          },
          "required": [
            "condition",
            "if_action"
          ]
        },
        "mxt:choice": {
          "$title": {
            "en_us": "Choice",
            "zh_cn": "选择"
          },
          "$description": {
            "en_us": "Picks one child action from a weighted list.",
            "zh_cn": "从加权列表中随机挑选一个子行为。"
          },
          "type": "object",
          "properties": {
            "actions": {
              "$title": {
                "en_us": "Actions",
                "zh_cn": "行为"
              },
              "type": "array",
              "items": {
                "$type": "mxt-common-block-action#block_action",
                "$title": {
                  "en_us": "Action",
                  "zh_cn": "行为"
                },
                "$description": {
                  "en_us": "One child action.",
                  "zh_cn": "一个子行为。"
                }
              },
              "default": [],
              "$description": {
                "en_us": "Actions value.",
                "zh_cn": "行为的值。"
              }
            }
          },
          "required": [
            "actions"
          ]
        },
        "mxt:offset": {
          "$title": {
            "en_us": "Offset",
            "zh_cn": "偏移"
          },
          "$description": {
            "en_us": "Runs the child action at an offset position.",
            "zh_cn": "在偏移后的位置执行子行为。"
          },
          "type": "object",
          "properties": {
            "action": {
              "$title": {
                "en_us": "Action",
                "zh_cn": "行为"
              },
              "$type": "mxt-common-block-action#block_action",
              "default": 0,
              "$description": {
                "en_us": "Action value.",
                "zh_cn": "行为的值。"
              }
            },
            "x": {
              "$title": {
                "en_us": "X",
                "zh_cn": "X"
              },
              "type": "integer",
              "default": 0,
              "$description": {
                "en_us": "X value.",
                "zh_cn": "X的值。"
              }
            },
            "y": {
              "$title": {
                "en_us": "Y",
                "zh_cn": "Y"
              },
              "type": "integer",
              "default": 0,
              "$description": {
                "en_us": "Y value.",
                "zh_cn": "Y的值。"
              }
            },
            "z": {
              "$title": {
                "en_us": "Z",
                "zh_cn": "Z"
              },
              "type": "integer",
              "default": 0,
              "$description": {
                "en_us": "Z value.",
                "zh_cn": "Z的值。"
              }
            }
          },
          "required": [
            "action"
          ]
        },
        "mxt:explode": {
          "$title": {
            "en_us": "Explode",
            "zh_cn": "爆炸"
          },
          "$description": {
            "en_us": "Creates an explosion.",
            "zh_cn": "制造一次爆炸。"
          },
          "type": "object",
          "properties": {
            "power": {
              "$title": {
                "en_us": "Power",
                "zh_cn": "能力"
              },
              "type": "number",
              "$description": {
                "en_us": "Power value.",
                "zh_cn": "能力的值。"
              }
            },
            "interaction": {
              "$title": {
                "en_us": "Interaction",
                "zh_cn": "交互"
              },
              "$description": {
                "en_us": "Interaction value.",
                "zh_cn": "交互的值。"
              }
            },
            "indestructible": {
              "$title": {
                "en_us": "Indestructible",
                "zh_cn": "不可破坏"
              },
              "$type": "mxt-common-block-condition#block_condition",
              "default": false,
              "$description": {
                "en_us": "Indestructible value.",
                "zh_cn": "不可破坏的值。"
              }
            },
            "create_fire": {
              "$title": {
                "en_us": "Create Fire",
                "zh_cn": "创建火焰"
              },
              "type": "boolean",
              "default": false,
              "$description": {
                "en_us": "Create Fire value.",
                "zh_cn": "创建火焰的值。"
              }
            }
          },
          "required": [
            "power"
          ]
        },
        "mxt:spawn_entity": {
          "$title": {
            "en_us": "Spawn Entity",
            "zh_cn": "生成实体"
          },
          "$description": {
            "en_us": "Spawns an entity above the block.",
            "zh_cn": "在方块上方生成一个实体。"
          },
          "type": "object",
          "properties": {
            "entity_type": {
              "$title": {
                "en_us": "Entity Type",
                "zh_cn": "实体类型"
              },
              "type": "string",
              "$description": {
                "en_us": "Entity Type value.",
                "zh_cn": "实体类型的值。"
              }
            },
            "tag": {
              "$title": {
                "en_us": "Tag",
                "zh_cn": "标签"
              },
              "$description": {
                "en_us": "Tag value.",
                "zh_cn": "标签的值。"
              }
            },
            "entity_action": {
              "$title": {
                "en_us": "Entity Action",
                "zh_cn": "实体行为"
              },
              "$type": "mxt-common-entity-action#entity_action",
              "$description": {
                "en_us": "Entity Action value.",
                "zh_cn": "实体行为的值。"
              }
            }
          },
          "required": [
            "entity_type"
          ]
        }
      }
    }
  }
}
