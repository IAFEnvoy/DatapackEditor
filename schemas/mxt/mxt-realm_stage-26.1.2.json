{
  "$title": {
    "en_us": "MiXianTu Realm Stage",
    "zh_cn": "觅仙途境界阶段"
  },
  "$description": {
    "en_us": "Data-driven Realm Stage definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的境界与突破条件定义。"
  },
  "type": "object",
  "properties": {
    "resource": {
      "$title": {
        "en_us": "Resource",
        "zh_cn": "资源"
      },
      "type": "string",
      "$registry": "mxt:resource",
      "$description": {
        "en_us": "Resource this stage is bound to.",
        "zh_cn": "该境界绑定的数值资源。"
      }
    },
    "aura_share_weight": {
      "$title": {
        "en_us": "Aura Share Weight",
        "zh_cn": "灵气分配权重"
      },
      "$type": "mxt-common#number_provider",
      "default": 1,
      "$description": {
        "en_us": "Weight used by realm_weighted aura-zone distribution.",
        "zh_cn": "灵气区域使用 realm_weighted 分配时采用的权重。"
      }
    },
    "cultivate_condition": {
      "$title": {
        "en_us": "Cultivation Condition",
        "zh_cn": "修炼条件"
      },
      "$type": "mxt-common-entity-condition#entity_condition",
      "$description": {
        "en_us": "Condition that must permit cultivation at this realm stage.",
        "zh_cn": "当前境界修炼时必须满足的条件。"
      }
    },
    "next_realm": {
      "$title": {
        "en_us": "Next Realm",
        "zh_cn": "下一境界"
      },
      "type": "string",
      "$description": {
        "en_us": "Stage a player breaks through to next.",
        "zh_cn": "突破后进入的下一境界。"
      }
    },
    "progress_threshold": {
      "$title": {
        "en_us": "Progress Threshold",
        "zh_cn": "进度阈值"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Cultivation progress needed to break through.",
        "zh_cn": "突破所需的修为进度。"
      }
    },
    "upgrade_conditions": {
      "$title": {
        "en_us": "Upgrade Conditions",
        "zh_cn": "突破条件"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-entity-condition#entity_condition",
        "$title": {
          "en_us": "Condition",
          "zh_cn": "条件"
        },
        "$description": {
          "en_us": "One condition checked when breaking through.",
          "zh_cn": "突破时检查的一条条件。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Extra conditions checked when breaking through.",
        "zh_cn": "突破时额外检查的条件。"
      }
    },
    "passive_modifiers": {
      "$title": {
        "en_us": "Passive Modifiers",
        "zh_cn": "被动修正"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common#record_AttributeEntry",
        "$title": {
          "en_us": "Modifier",
          "zh_cn": "属性修正"
        },
        "$description": {
          "en_us": "One attribute modifier.",
          "zh_cn": "一条属性修正。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Attribute modifiers granted while in this stage.",
        "zh_cn": "处于该境界时获得的属性修正。"
      }
    },
    "costs": {
      "$title": {
        "en_us": "Costs",
        "zh_cn": "消耗"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common#record_ResourceCost",
        "$title": {
          "en_us": "Cost",
          "zh_cn": "消耗"
        },
        "$description": {
          "en_us": "One cost paid per use.",
          "zh_cn": "每次使用支付的一项消耗。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Resources paid to break through.",
        "zh_cn": "突破时支付的资源。"
      }
    },
    "ability_requirements": {
      "$title": {
        "en_us": "Ability Requirements",
        "zh_cn": "技能需求"
      },
      "type": "array",
      "items": {
        "$title": {
          "en_us": "Ability",
          "zh_cn": "技能"
        },
        "$description": {
          "en_us": "One required ability id.",
          "zh_cn": "要求拥有的一个技能 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Abilities a player must already have to break through.",
        "zh_cn": "突破前必须已经拥有的技能。"
      }
    },
    "tribulation": {
      "$title": {
        "en_us": "Tribulation",
        "zh_cn": "天劫"
      },
      "type": "string",
      "$registry": "mxt:tribulation",
      "$description": {
        "en_us": "Tribulation triggered by the breakthrough.",
        "zh_cn": "突破时触发的天劫。"
      }
    },
    "breakthrough_particle": {
      "$title": {
        "en_us": "Breakthrough Particle",
        "zh_cn": "突破粒子"
      },
      "$type": "mxt-common-aura#record_ParticleEffect",
      "$description": {
        "en_us": "Particles drawn when the breakthrough happens.",
        "zh_cn": "突破时绘制的粒子。"
      }
    },
    "success_action": {
      "$title": {
        "en_us": "Success Action",
        "zh_cn": "成功行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the breakthrough succeeds.",
        "zh_cn": "突破成功时执行的行为。"
      }
    },
    "fail_action": {
      "$title": {
        "en_us": "Fail Action",
        "zh_cn": "失败行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the breakthrough fails.",
        "zh_cn": "突破失败时执行的行为。"
      }
    }
  },
  "required": [
    "resource",
    "progress_threshold"
  ],
  "id": "mxt-realm_stage",
  "$version": "26.1.2",
  "$registry": "mxt:realm_stage",
  "$path": "data/<namespace>/mxt/realm_stage/<path>.json"
}
