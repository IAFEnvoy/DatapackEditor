{
  "$title": {
    "en_us": "MiXianTu Forging Blueprint",
    "zh_cn": "觅仙途锻造蓝图"
  },
  "$description": {
    "en_us": "Data-driven Forging Blueprint definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的锻造目标与要求定义。"
  },
  "type": "object",
  "required": [
    "input",
    "meter_min",
    "meter_max",
    "target_min",
    "target_max",
    "quality_by_extra_steps",
    "result"
  ],
  "properties": {
    "input": {
      "$title": {
        "en_us": "Input",
        "zh_cn": "输入"
      },
      "$description": {
        "en_us": "Input of this ForgingBlueprint.",
        "zh_cn": "输入的值。"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-content#record_ForgingMaterial",
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      }
    },
    "allowed_methods": {
      "$title": {
        "en_us": "Allowed Methods",
        "zh_cn": "允许的锻打方式"
      },
      "$description": {
        "en_us": "Allowed Methods of this ForgingBlueprint.",
        "zh_cn": "允许的锻打方式的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Identifier",
            "zh_cn": "标识符"
          },
          "$description": {
            "en_us": "One accepted form of this value: identifier.",
            "zh_cn": "标识符的值。"
          },
          "type": "string",
          "$registry": "mxt:forging_method"
        },
        {
          "$title": {
            "en_us": "Tag",
            "zh_cn": "标签"
          },
          "$description": {
            "en_us": "One accepted form of this value: tag.",
            "zh_cn": "标签的值。"
          },
          "type": "string",
          "$registry": "mxt:forging_method_tag",
          "pattern": "^#.+"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$title": {
                  "en_us": "Identifier",
                  "zh_cn": "标识符"
                },
                "$description": {
                  "en_us": "One accepted form of this value: identifier.",
                  "zh_cn": "标识符的值。"
                },
                "type": "string",
                "$registry": "mxt:forging_method"
              },
              {
                "$title": {
                  "en_us": "Tag",
                  "zh_cn": "标签"
                },
                "$description": {
                  "en_us": "One accepted form of this value: tag.",
                  "zh_cn": "标签的值。"
                },
                "type": "string",
                "$registry": "mxt:forging_method_tag",
                "pattern": "^#.+"
              }
            ],
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "meter_min": {
      "$title": {
        "en_us": "Meter Min",
        "zh_cn": "数值条下界"
      },
      "$description": {
        "en_us": "Meter Min of this MeterBounds.",
        "zh_cn": "数值条下界的值。"
      },
      "type": "integer"
    },
    "meter_max": {
      "$title": {
        "en_us": "Meter Max",
        "zh_cn": "数值条上界"
      },
      "$description": {
        "en_us": "Meter Max of this MeterBounds.",
        "zh_cn": "数值条上界的值。"
      },
      "type": "integer"
    },
    "target_min": {
      "$title": {
        "en_us": "Target Min",
        "zh_cn": "成功区间下界"
      },
      "$description": {
        "en_us": "Target Min of this MeterBounds.",
        "zh_cn": "成功区间下界的值。"
      },
      "type": "integer"
    },
    "target_max": {
      "$title": {
        "en_us": "Target Max",
        "zh_cn": "成功区间上界"
      },
      "$description": {
        "en_us": "Target Max of this MeterBounds.",
        "zh_cn": "成功区间上界的值。"
      },
      "type": "integer"
    },
    "finish_pattern": {
      "$title": {
        "en_us": "Finish Pattern",
        "zh_cn": "结束模式"
      },
      "$description": {
        "en_us": "Finish Pattern of this ForgingBlueprint.",
        "zh_cn": "结束模式的值。"
      },
      "$type": "mxt-common-content#record_FinishPattern"
    },
    "max_steps": {
      "$title": {
        "en_us": "Max Steps",
        "zh_cn": "最大步数"
      },
      "$description": {
        "en_us": "Max Steps of this ForgingBlueprint.",
        "zh_cn": "最大步数的值。"
      },
      "type": "integer",
      "minimum": 0
    },
    "quality_by_extra_steps": {
      "$title": {
        "en_us": "Quality By Extra Steps",
        "zh_cn": "按额外步数确定品质"
      },
      "$description": {
        "en_us": "Quality By Extra Steps of this ForgingBlueprint.",
        "zh_cn": "按额外步数确定品质的值。"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-content#record_QualityThreshold",
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      }
    },
    "result": {
      "$title": {
        "en_us": "Result",
        "zh_cn": "结果"
      },
      "$description": {
        "en_us": "Result of this ForgingBlueprint.",
        "zh_cn": "结果的值。"
      },
      "type": "string"
    },
    "complete_action": {
      "$title": {
        "en_us": "Complete Action",
        "zh_cn": "完成行为"
      },
      "$description": {
        "en_us": "Complete Action of this ForgingBlueprint.",
        "zh_cn": "完成行为的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Entity Action",
            "zh_cn": "实体行为"
          },
          "$description": {
            "en_us": "One accepted form of this value: entity action.",
            "zh_cn": "实体行为的值。"
          },
          "$type": "mxt-common-entity-action#entity_action"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "$type": "mxt-common-entity-action#entity_action",
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "fail_action": {
      "$title": {
        "en_us": "Fail Action",
        "zh_cn": "失败行为"
      },
      "$description": {
        "en_us": "Fail Action of this ForgingBlueprint.",
        "zh_cn": "失败行为的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Entity Action",
            "zh_cn": "实体行为"
          },
          "$description": {
            "en_us": "One accepted form of this value: entity action.",
            "zh_cn": "实体行为的值。"
          },
          "$type": "mxt-common-entity-action#entity_action"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "$type": "mxt-common-entity-action#entity_action",
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "failure_settlement": {
      "$title": {
        "en_us": "Failure Settlement",
        "zh_cn": "失败结算"
      },
      "$description": {
        "en_us": "Failure Settlement of this ForgingBlueprint.",
        "zh_cn": "失败结算的值。"
      },
      "$type": "mxt-common-content#record_FailureSettlement"
    }
  },
  "id": "mxt-forging_blueprint",
  "$version": "26.1.2",
  "$registry": "mxt:forging_blueprint",
  "$path": "data/<namespace>/mxt/forging_blueprint/<path>.json"
}
