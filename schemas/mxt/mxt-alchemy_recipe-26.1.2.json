{
  "$title": {
    "en_us": "MiXianTu Alchemy Recipe",
    "zh_cn": "觅仙途炼丹配方"
  },
  "$description": {
    "en_us": "Data-driven Alchemy Recipe definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的炼丹配方定义。"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "$title": {
        "en_us": "Inputs",
        "zh_cn": "材料"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Material",
          "zh_cn": "材料"
        },
        "$description": {
          "en_us": "One material the recipe consumes.",
          "zh_cn": "配方消耗的一项材料。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Materials the recipe consumes, as an unordered list.",
        "zh_cn": "配方消耗的材料，无序列表。"
      }
    },
    "target_temperature": {
      "$title": {
        "en_us": "Target Temperature",
        "zh_cn": "目标温度"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Temperature the furnace has to reach before the brew progresses.",
        "zh_cn": "丹炉需要达到的温度，达到后炼丹才会推进。"
      }
    },
    "temperature_tolerance": {
      "$title": {
        "en_us": "Temperature Tolerance",
        "zh_cn": "温度容差"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "How far the temperature may drift from the target and still count.",
        "zh_cn": "温度相对目标允许的偏差范围。"
      }
    },
    "minimum_furnace_tier": {
      "$title": {
        "en_us": "Minimum Furnace Tier",
        "zh_cn": "最低丹炉阶"
      },
      "type": "integer",
      "default": 0,
      "$description": {
        "en_us": "Lowest furnace tier that can brew this recipe.",
        "zh_cn": "能够炼制该配方的最低丹炉等级。"
      }
    },
    "duration": {
      "$title": {
        "en_us": "Duration",
        "zh_cn": "持续时间"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Brewing time in ticks.",
        "zh_cn": "炼丹所需的时间，单位 tick。"
      }
    },
    "aura_kinds": {
      "$title": {
        "en_us": "Aura Kinds",
        "zh_cn": "灵气类型"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Aura Kind",
          "zh_cn": "灵气类型"
        },
        "$description": {
          "en_us": "One aura kind identifier.",
          "zh_cn": "一个灵气类型标识符。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Aura kinds the environment has to provide.",
        "zh_cn": "环境需要提供的灵气类型。"
      }
    },
    "minimum_aura": {
      "$title": {
        "en_us": "Minimum Resource Aura",
        "zh_cn": "最低资源灵气"
      },
      "type": "object",
      "additionalProperties": {
        "$type": "mxt-common#number_provider",
        "$title": {
          "en_us": "Resource Minimum",
          "zh_cn": "资源最低值"
        },
        "$description": {
          "en_us": "Minimum environmental aura of this resource the recipe needs, keyed by mxt:resource ids.",
          "zh_cn": "该配方要求的这种资源最低环境灵气，键为 mxt:resource ID。"
        }
      },
      "default": {},
      "$description": {
        "en_us": "Per-resource environmental minimums; keys are mxt:resource IDs.",
        "zh_cn": "按资源分别定义的环境最低值，键为 mxt:resource ID。"
      }
    },
    "success_outputs": {
      "$title": {
        "en_us": "Success Outputs",
        "zh_cn": "成功产物"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Output",
          "zh_cn": "产出"
        },
        "$description": {
          "en_us": "One item produced on success.",
          "zh_cn": "成功时产出的一件物品。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Items produced when the brew succeeds.",
        "zh_cn": "炼丹成功时产出的物品。"
      }
    },
    "failure_outputs": {
      "$title": {
        "en_us": "Failure Outputs",
        "zh_cn": "失败产物"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Output",
          "zh_cn": "产出"
        },
        "$description": {
          "en_us": "One item produced on failure.",
          "zh_cn": "失败时产出的一件物品。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Items produced when the brew fails.",
        "zh_cn": "炼丹失败时产出的物品。"
      }
    },
    "success_action": {
      "$title": {
        "en_us": "Success Action",
        "zh_cn": "成功行为"
      },
      "type": "object",
      "$description": {
        "en_us": "Action run on the brewer when the brew succeeds.",
        "zh_cn": "炼丹成功时对炼丹者执行的行为。"
      }
    },
    "failure_action": {
      "$title": {
        "en_us": "Failure Action",
        "zh_cn": "失败行为"
      },
      "type": "object",
      "$description": {
        "en_us": "Action run on the brewer when the brew fails.",
        "zh_cn": "炼丹失败时对炼丹者执行的行为。"
      }
    },
    "success_block_action": {
      "$title": {
        "en_us": "Success Block Action",
        "zh_cn": "成功方块行为"
      },
      "type": "object",
      "$description": {
        "en_us": "Action executed at the workstation block on success.",
        "zh_cn": "成功时在工作台方块位置执行的行为。"
      }
    },
    "failure_block_action": {
      "$title": {
        "en_us": "Failure Block Action",
        "zh_cn": "失败方块行为"
      },
      "type": "object",
      "$description": {
        "en_us": "Action executed at the workstation block on failure.",
        "zh_cn": "失败时在工作台方块位置执行的行为。"
      }
    }
  },
  "required": [
    "inputs",
    "target_temperature",
    "duration",
    "success_outputs"
  ],
  "id": "mxt-alchemy_recipe",
  "$version": "26.1.2",
  "$registry": "mxt:alchemy_recipe",
  "$path": "data/<namespace>/mxt/alchemy_recipe/<path>.json"
}
