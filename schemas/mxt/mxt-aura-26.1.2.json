{
  "$title": {
    "en_us": "MiXianTu Aura",
    "zh_cn": "觅仙途灵气"
  },
  "$description": {
    "en_us": "Data-driven Aura definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的灵气定义。"
  },
  "type": "object",
  "required": [
    "resource"
  ],
  "properties": {
    "name": {
      "$title": {
        "en_us": "Name",
        "zh_cn": "名称"
      },
      "$description": {
        "en_us": "Name of this Aura.",
        "zh_cn": "名称的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "description": {
      "$title": {
        "en_us": "Description",
        "zh_cn": "描述"
      },
      "$description": {
        "en_us": "Description of this Aura.",
        "zh_cn": "描述的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "resource": {
      "$title": {
        "en_us": "Resource",
        "zh_cn": "资源"
      },
      "$description": {
        "en_us": "Resource of this Aura.",
        "zh_cn": "资源的值。"
      },
      "type": "string",
      "$registry": "mxt:resource"
    },
    "first_realm": {
      "$title": {
        "en_us": "First Realm",
        "zh_cn": "首个境界"
      },
      "$description": {
        "en_us": "First Realm of this Aura.",
        "zh_cn": "首个境界的值。"
      },
      "type": "string",
      "$registry": "mxt:realm_stage"
    },
    "start_exp": {
      "$title": {
        "en_us": "Start Exp",
        "zh_cn": "开始 Exp"
      },
      "$description": {
        "en_us": "Start Exp of this Aura.",
        "zh_cn": "开始 Exp的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "start_cultivate_conditions": {
      "$title": {
