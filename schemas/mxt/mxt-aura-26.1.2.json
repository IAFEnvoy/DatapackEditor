      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "aura_type": {
      "$title": {
        "en_us": "Aura Type",
        "zh_cn": "灵气类型"
      },
      "$description": {
        "en_us": "Aura Type of this Aura.",
        "zh_cn": "灵气类型的值。"
      },
      "type": "string",
      "$registry": "mxt:element"
    },
    "burst_amount": {
      "$title": {
        "en_us": "Burst Amount",
        "zh_cn": "Burst 数量"
      },
      "$description": {
        "en_us": "Burst Amount of this Aura.",
        "zh_cn": "Burst 数量的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "use_condition": {
      "$title": {
        "en_us": "Use Condition",
        "zh_cn": "使用条件"
      },
      "$description": {
        "en_us": "Use Condition of this Aura.",
        "zh_cn": "使用条件的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Entity Condition",
            "zh_cn": "实体条件"
          },
          "$description": {
            "en_us": "One accepted form of this value: entity condition.",
            "zh_cn": "实体条件的值。"
          },
          "$type": "mxt-common-entity-condition#entity_condition"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "$type": "mxt-common-entity-condition#entity_condition",
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "show_cultivation_info": {
      "$title": {
        "en_us": "Show Cultivation Info",
        "zh_cn": "显示修炼 Info"
      },
      "$description": {
        "en_us": "Show Cultivation Info of this Aura.",
        "zh_cn": "显示修炼 Info的值。"
      },
      "type": "boolean",
      "default": true
    }
  },
  "id": "mxt-aura",
  "$version": "26.1.2",
  "$registry": "mxt:aura",
  "$path": "data/<namespace>/mxt/aura/<path>.json"
}
