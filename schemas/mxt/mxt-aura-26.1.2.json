        "zh_cn": "开始修炼条件"
      },
      "$description": {
        "en_us": "Start Cultivate Conditions of this Aura.",
        "zh_cn": "开始修炼条件的值。"
      },
      "$type": "mxt-common-content#record_CultivateConditions"
    },
    "cultivation_to_resource": {
      "$title": {
