{
  "$title": {
    "en_us": "MiXianTu Tribulation",
    "zh_cn": "觅仙途天劫"
  },
  "$description": {
    "en_us": "Data-driven Tribulation definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的天劫定义。"
  },
  "type": "object",
  "properties": {
    "trigger_condition": {
      "$title": {
        "en_us": "Trigger Condition",
        "zh_cn": "触发条件"
      },
      "$type": "mxt-common-entity-condition#entity_condition",
      "$description": {
        "en_us": "Condition that starts the tribulation.",
        "zh_cn": "触发天劫的条件。"
      }
    },
    "phases": {
      "$title": {
        "en_us": "Phases",
        "zh_cn": "阶段"
      },
      "type": "array",
      "items": {
        "$type": "mxt-common-content#record_Phase",
        "$title": {
          "en_us": "Phase",
          "zh_cn": "阶段"
        },
        "$description": {
          "en_us": "One phase of the tribulation.",
          "zh_cn": "天劫中的一个阶段。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Phases the tribulation goes through.",
        "zh_cn": "天劫经历的阶段。"
      }
    },
    "difficulty_scale": {
      "$title": {
        "en_us": "Difficulty Scale",
        "zh_cn": "难度倍率"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Multiplier applied to the tribulation's difficulty.",
        "zh_cn": "天劫难度的倍率。"
      }
    },
    "success_action": {
      "$title": {
        "en_us": "Success Action",
        "zh_cn": "成功行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the tribulation is survived.",
        "zh_cn": "渡过天劫时执行的行为。"
      }
    },
    "fail_action": {
      "$title": {
        "en_us": "Fail Action",
        "zh_cn": "失败行为"
      },
      "$type": "mxt-common-entity-action#entity_action",
      "$description": {
        "en_us": "Action run when the tribulation is failed.",
        "zh_cn": "天劫失败时执行的行为。"
      }
    }
  },
  "required": [
    "phases"
  ],
  "id": "mxt-tribulation",
  "$version": "26.1.2",
  "$registry": "mxt:tribulation",
  "$path": "data/<namespace>/mxt/tribulation/<path>.json"
}
