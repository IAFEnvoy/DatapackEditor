{
  "$title": {
    "en_us": "MiXianTu Skill Stage",
    "zh_cn": "觅仙途技能水平"
  },
  "$description": {
    "en_us": "Data-driven Skill Stage definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的技能水平定义。"
  },
  "type": "object",
  "required": [
    "skill"
  ],
  "properties": {
    "name": {
      "$title": {
        "en_us": "Name",
        "zh_cn": "名称"
      },
      "$description": {
        "en_us": "Name of this SkillStage.",
        "zh_cn": "名称的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "description": {
      "$title": {
        "en_us": "Description",
        "zh_cn": "描述"
      },
      "$description": {
        "en_us": "Description of this SkillStage.",
        "zh_cn": "描述的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "skill": {
      "$title": {
        "en_us": "Skill",
        "zh_cn": "技能"
      },
      "$description": {
        "en_us": "Skill of this SkillStage.",
        "zh_cn": "技能的值。"
      },
      "type": "string"
    },
    "next_stage": {
      "$title": {
        "en_us": "Next Stage",
        "zh_cn": "下一阶段"
      },
      "$description": {
        "en_us": "Next Stage of this SkillStage.",
        "zh_cn": "下一阶段的值。"
      },
      "type": "string",
      "$registry": "mxt:skill_stage"
    },
    "mastery": {
      "$title": {
        "en_us": "Mastery",
        "zh_cn": "Mastery"
      },
      "$description": {
        "en_us": "Mastery of this SkillStage.",
        "zh_cn": "Mastery的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "damage_multiplier": {
      "$title": {
        "en_us": "Damage Multiplier",
        "zh_cn": "伤害倍率"
      },
      "$description": {
        "en_us": "Damage Multiplier of this SkillStage.",
        "zh_cn": "伤害倍率的值。"
      },
      "type": "number",
      "default": 1
    }
  },
  "id": "mxt-skill_stage",
  "$version": "26.1.2",
  "$registry": "mxt:skill_stage",
  "$path": "data/<namespace>/mxt/skill_stage/<path>.json"
}
