{
  "$title": {
    "en_us": "MiXianTu Spirit Root",
    "zh_cn": "觅仙途灵根"
  },
  "$description": {
    "en_us": "Data-driven Spirit Root definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的灵根定义。"
  },
  "type": "object",
  "required": [
    "elements"
  ],
  "properties": {
    "name": {
      "$title": {
        "en_us": "Name",
        "zh_cn": "名称"
      },
      "$description": {
        "en_us": "Name of this SpiritRoot.",
        "zh_cn": "名称的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "description": {
      "$title": {
        "en_us": "Description",
        "zh_cn": "描述"
      },
      "$description": {
        "en_us": "Description of this SpiritRoot.",
        "zh_cn": "描述的值。"
      },
      "type": [
        "string",
        "object"
      ]
    },
    "elements": {
      "$title": {
        "en_us": "Elements",
        "zh_cn": "元素"
      },
      "$description": {
        "en_us": "Elements of this SpiritRoot.",
        "zh_cn": "元素的值。"
      },
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$title": {
              "en_us": "Object",
              "zh_cn": "对象"
            },
            "$description": {
              "en_us": "One accepted form of this value: object.",
              "zh_cn": "对象的值。"
            },
            "type": "object",
            "required": [
              "element"
            ],
            "properties": {
              "element": {
                "type": "string",
                "$registry": "mxt:element",
                "$title": {
                  "en_us": "Element",
                  "zh_cn": "元素"
                },
                "$description": {
                  "en_us": "Element value.",
                  "zh_cn": "元素的值。"
                }
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "default": 1,
                "$title": {
                  "en_us": "Weight",
                  "zh_cn": "权重"
                },
                "$description": {
                  "en_us": "Share of the root this element makes up; the shares are normalised, so only their ratio matters. Must be positive.",
                  "zh_cn": "权重的值。"
                }
              }
            }
          },
          {
            "$title": {
              "en_us": "Element",
              "zh_cn": "元素"
            },
            "$description": {
              "en_us": "One accepted form of this value: identifier.",
              "zh_cn": "元素的值。"
            },
            "type": "string",
            "$registry": "mxt:element"
          }
        ],
        "$title": {
          "en_us": "Item",
          "zh_cn": "物品"
        },
        "$description": {
          "en_us": "Item value.",
          "zh_cn": "物品的值。"
        }
      }
    },
    "cultivation_multiplier": {
      "$title": {
        "en_us": "Cultivation Multiplier",
        "zh_cn": "修炼倍率"
      },
      "$description": {
        "en_us": "Cultivation Multiplier of this SpiritRoot.",
        "zh_cn": "修炼倍率的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "element_ability_modifier": {
      "$title": {
        "en_us": "Element Ability Modifier",
        "zh_cn": "元素技能修正"
      },
      "$description": {
        "en_us": "Element Ability Modifier of this SpiritRoot.",
        "zh_cn": "元素技能修正的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Text",
            "zh_cn": "文本"
          },
          "$description": {
            "en_us": "One accepted form of this value: text.",
            "zh_cn": "文本的值。"
          },
          "type": "string"
        },
        {
          "$title": {
            "en_us": "Number",
            "zh_cn": "数值"
          },
          "$description": {
            "en_us": "One accepted form of this value: number.",
            "zh_cn": "数值的值。"
          },
          "type": "number"
        },
        {
          "$title": {
            "en_us": "Number Provider",
            "zh_cn": "数值提供器"
          },
          "$description": {
            "en_us": "One accepted form of this value: number provider.",
            "zh_cn": "数值提供器的值。"
          },
          "$type": "mxt-common#number_provider"
        }
      ]
    },
    "rarity": {
      "$title": {
        "en_us": "Rarity",
        "zh_cn": "稀有度"
      },
      "$description": {
        "en_us": "Rarity of this SpiritRoot.",
        "zh_cn": "稀有度的值。"
      },
      "type": "string",
      "default": "common"
    },
    "granted_abilities": {
      "$title": {
        "en_us": "Granted Abilities",
        "zh_cn": "授予的技能"
      },
      "$description": {
        "en_us": "Granted Abilities of this SpiritRoot.",
        "zh_cn": "授予的技能的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Identifier",
            "zh_cn": "标识符"
          },
          "$description": {
            "en_us": "One accepted form of this value: identifier.",
            "zh_cn": "标识符的值。"
          },
          "type": "string",
          "$registry": "mxt:ability"
        },
        {
          "$title": {
            "en_us": "Tag",
            "zh_cn": "标签"
          },
          "$description": {
            "en_us": "One accepted form of this value: tag.",
            "zh_cn": "标签的值。"
          },
          "type": "string",
          "$registry": "mxt:ability_tag",
          "pattern": "^#.+"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$title": {
                  "en_us": "Identifier",
                  "zh_cn": "标识符"
                },
                "$description": {
                  "en_us": "One accepted form of this value: identifier.",
                  "zh_cn": "标识符的值。"
                },
                "type": "string",
                "$registry": "mxt:ability"
              },
              {
                "$title": {
                  "en_us": "Tag",
                  "zh_cn": "标签"
                },
                "$description": {
                  "en_us": "One accepted form of this value: tag.",
                  "zh_cn": "标签的值。"
                },
                "type": "string",
                "$registry": "mxt:ability_tag",
                "pattern": "^#.+"
              }
            ],
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    },
    "conflicting_elements": {
      "$title": {
        "en_us": "Conflicting Elements",
        "zh_cn": "Conflicting 元素"
      },
      "$description": {
        "en_us": "Conflicting Elements of this SpiritRoot.",
        "zh_cn": "Conflicting 元素的值。"
      },
      "oneOf": [
        {
          "$title": {
            "en_us": "Identifier",
            "zh_cn": "标识符"
          },
          "$description": {
            "en_us": "One accepted form of this value: identifier.",
            "zh_cn": "标识符的值。"
          },
          "type": "string",
          "$registry": "mxt:element"
        },
        {
          "$title": {
            "en_us": "Tag",
            "zh_cn": "标签"
          },
          "$description": {
            "en_us": "One accepted form of this value: tag.",
            "zh_cn": "标签的值。"
          },
          "type": "string",
          "$registry": "mxt:element_tag",
          "pattern": "^#.+"
        },
        {
          "$title": {
            "en_us": "List",
            "zh_cn": "列表"
          },
          "$description": {
            "en_us": "One accepted form of this value: list.",
            "zh_cn": "列表的值。"
          },
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$title": {
                  "en_us": "Identifier",
                  "zh_cn": "标识符"
                },
                "$description": {
                  "en_us": "One accepted form of this value: identifier.",
                  "zh_cn": "标识符的值。"
                },
                "type": "string",
                "$registry": "mxt:element"
              },
              {
                "$title": {
                  "en_us": "Tag",
                  "zh_cn": "标签"
                },
                "$description": {
                  "en_us": "One accepted form of this value: tag.",
                  "zh_cn": "标签的值。"
                },
                "type": "string",
                "$registry": "mxt:element_tag",
                "pattern": "^#.+"
              }
            ],
            "$title": {
              "en_us": "Item",
              "zh_cn": "物品"
            },
            "$description": {
              "en_us": "Item value.",
              "zh_cn": "物品的值。"
            }
          }
        }
      ]
    }
  },
  "id": "mxt-spirit_root",
  "$version": "26.1.2",
  "$registry": "mxt:spirit_root",
  "$path": "data/<namespace>/mxt/spirit_root/<path>.json"
}
