{
  "$title": {
    "en_us": "MiXianTu Spirit Root",
    "zh_cn": "觅仙途灵根"
  },
  "$description": {
    "en_us": "Data-driven Spirit Root definition from MiXianTu.",
    "zh_cn": "由觅仙途数据包加载的灵根定义。"
  },
  "type": "object",
  "properties": {
    "element": {
      "$title": {
        "en_us": "Element",
        "zh_cn": "元素"
      },
      "type": "string",
      "$registry": "mxt:element",
      "$description": {
        "en_us": "Element of this spirit root.",
        "zh_cn": "该灵根对应的元素。"
      }
    },
    "cultivation_multiplier": {
      "$title": {
        "en_us": "Cultivation Multiplier",
        "zh_cn": "修炼倍率"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Multiplier applied to cultivation speed.",
        "zh_cn": "对修炼速度施加的倍率。"
      }
    },
    "element_ability_modifier": {
      "$title": {
        "en_us": "Element Ability Modifier",
        "zh_cn": "元素技能修正"
      },
      "$type": "mxt-common#number_provider",
      "$description": {
        "en_us": "Modifier applied to abilities of the matching element.",
        "zh_cn": "对相应元素技能施加的修正。"
      }
    },
    "rarity": {
      "$title": {
        "en_us": "Rarity",
        "zh_cn": "稀有度"
      },
      "default": "common",
      "$description": {
        "en_us": "How rare this spirit root is.",
        "zh_cn": "该灵根的稀有度。"
      }
    },
    "granted_abilities": {
      "$title": {
        "en_us": "Granted Abilities",
        "zh_cn": "授予的技能"
      },
      "type": "array",
      "items": {
        "$title": {
          "en_us": "Ability",
          "zh_cn": "技能"
        },
        "$description": {
          "en_us": "One ability id.",
          "zh_cn": "一个技能 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Abilities unlocked by this spirit root.",
        "zh_cn": "该灵根解锁的技能。"
      }
    },
    "compatibility_tags": {
      "$title": {
        "en_us": "Compatibility Tags",
        "zh_cn": "兼容标签"
      },
      "type": "array",
      "items": {
        "type": "string",
        "$title": {
          "en_us": "Tag",
          "zh_cn": "标签"
        },
        "$description": {
          "en_us": "One tag id.",
          "zh_cn": "一个标签 ID。"
        }
      },
      "default": [],
      "$description": {
        "en_us": "Tags used for compatibility checks.",
        "zh_cn": "用于兼容性判断的标签。"
      }
    }
  },
  "required": [
    "element"
  ],
  "id": "mxt-spirit_root",
  "$version": "26.1.2",
  "$registry": "mxt:spirit_root",
  "$path": "data/<namespace>/mxt/spirit_root/<path>.json"
}
